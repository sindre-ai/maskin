{
	"$schema": "https://turbo.build/schema.json",
	"globalPassThroughEnv": [
		"DATABASE_URL",
		"DATABASE_URL_DIRECT",
		"POSTGRES_URL",
		"PORT",
		"METRICS_PORT",
		"AGENT_SERVER_STALL_THRESHOLD_MS",
		"AGENT_SERVER_INSTANCE",
		"DEPLOY_ENV",
		"MASKIN_COMMIT_SHA",
		"GITHUB_SHA",
		"INTEGRATION_ENCRYPTION_KEY",
		"GITHUB_APP_ID",
		"GITHUB_CLIENT_ID",
		"GITHUB_CLIENT_SECRET",
		"GITHUB_APP_WEBHOOK_SECRET",
		"GITHUB_APP_PRIVATE_KEY",
		"GITHUB_APP_SLUG",
		"GITHUB_APP_INSTALLATION_RECOVERY_ENABLED",
		"GITHUB_REPO",
		"S3_ENDPOINT",
		"S3_BUCKET",
		"S3_ACCESS_KEY",
		"S3_SECRET_KEY",
		"S3_REGION",
		"SLACK_CLIENT_ID",
		"SLACK_CLIENT_SECRET",
		"SLACK_SIGNING_SECRET",
		"MASKIN_MACHINE_ICON_URL",
		"LINEAR_CLIENT_ID",
		"LINEAR_CLIENT_SECRET",
		"LINEAR_WEBHOOK_SECRET",
		"GMAIL_CLIENT_ID",
		"GMAIL_CLIENT_SECRET",
		"GMAIL_PUBSUB_TOPIC",
		"GMAIL_PUBSUB_AUDIENCE",
		"GMAIL_PUBSUB_SERVICE_ACCOUNT",
		"GOOGLE_CALENDAR_CLIENT_ID",
		"GOOGLE_CALENDAR_CLIENT_SECRET",
		"CORS_ORIGIN",
		"FRONTEND_URL",
		"API_BASE_URL",
		"WEB_APP_URL",
		"MASKIN_FALLBACK_OPENROUTER_KEY",
		"MASKIN_FALLBACK_BASE_URL",
		"MASKIN_FALLBACK_MODEL",
		"MASKIN_FALLBACK_SMALL_MODEL",
		"MASKIN_FALLBACK_DAILY_TOKEN_LIMIT",
		"MASKIN_TRIAL_HARD_CAP_USD_CENTS",
		"MASKIN_ENTERPRISE_ACTOR_IDS",
		"MASKIN_TEST_GRANT_TOKEN",
		"STRIPE_SECRET_KEY",
		"STRIPE_WEBHOOK_SECRET",
		"STRIPE_PRICE_PRO",
		"STRIPE_PRICE_TEAM",
		"MASKIN_PRO_HARD_CAP_USD_CENTS",
		"MASKIN_TEAM_HARD_CAP_USD_CENTS",
		"MASKIN_CLAUDE_FAILOVER_ENABLED",
		"NODE_ENV",
		"TRUSTED_PROXY_CIDRS",
		"WORKSPACE_DAILY_DRAFT_CAP",
		"PER_COOKIE_DRAFT_CAP",
		"PER_IP_DRAFT_CAP_DAY",
		"GUEST_CLAIM_TTL_HOURS",
		"VITE_POSTHOG_KEY",
		"VITE_POSTHOG_HOST",
		"AGENT_SERVER_SECRET",
		"MASKIN_AGENT_SERVER_PUBLIC_HOST",
		"AGENT_SESSION_ROOT",
		"MSB_BIN",
		"RUNTIME_BACKEND",
		"AGENT_SERVER_SHARED_SECRET",
		"WARM_POOL_IMAGE",
		"WARM_POOL_REFRESH_MINUTES",
		"POSTHOG_API_KEY",
		"POSTHOG_HOST",
		"MASKIN_TELEMETRY_DISABLED",
		"MASKIN_TELEMETRY_STATE_PATH",
		"SENTRY_DSN_DEV",
		"SENTRY_DSN_AGENT_SERVER",
		"VITE_SENTRY_DSN",
		"SENTRY_FORCE_ENABLE",
		"VITE_SENTRY_FORCE_ENABLE",
		"VITE_FARO_URL",
		"VITE_FARO_APP_KEY",
		"VITE_FARO_FORCE_ENABLE",
		"VITE_MASKIN_COMMIT_SHA",
		"FARO_SOURCEMAP_ENDPOINT",
		"FARO_APP_ID",
		"FARO_STACK_ID",
		"FARO_API_KEY",
		"AGENT_SERVERS",
		"AGENT_SERVER_MAX_SESSIONS",
		"AGENT_BASE_IMAGE",
		"BROWSER_SIDECAR_IMAGE",
		"MSB_BRIDGE_GATEWAY",
		"MASKIN_BACKEND_URL",
		"POSTHOG_PROJECT_ID",
		"POSTHOG_PERSONAL_API_KEY",
		"WINDOW_DAYS",
		"MASKIN_DEV_EXTERNAL",
		"METHOD_WORKSPACE_ID",
		"FF_TESTER_ACTOR_IDS",
		"FF_TESTER_FEATURES"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "dist-mcp/**"]
		},
		"build:mcp": {
			"dependsOn": ["^build"],
			"outputs": ["dist-mcp/**"]
		},
		"dev": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		},
		"test": {
			"dependsOn": ["^build"]
		},
		"test:integration": {
			"dependsOn": ["^build"],
			"cache": false,
			"env": ["DATABASE_URL"]
		},
		"test:e2e": {
			"dependsOn": ["^build"],
			"cache": false,
			"env": ["DATABASE_URL"]
		},
		"type-check": {
			"dependsOn": ["^build"],
			"outputs": ["**/*.tsbuildinfo"]
		},
		"lint": {},
		"db:generate": {
			"cache": false
		},
		"db:migrate": {
			"cache": false
		},
		"db:seed": {
			"cache": false
		}
	}
}
