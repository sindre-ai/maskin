DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maskin
# Optional: overrides DATABASE_URL
# POSTGRES_URL=
# Optional: direct (non-pooled) connection for PG LISTEN/NOTIFY when using a connection pooler
# DATABASE_URL_DIRECT=

# Integration secrets encryption key (32-byte hex, 64 chars).
# Auto-generated by `pnpm dev` / `pnpm dev:win` if missing. Required to encrypt stored OAuth tokens.
INTEGRATION_ENCRYPTION_KEY=

# Keychain: the master key that wraps each credential's data key (32 bytes, 64 hex chars).
# Required in production. Elsewhere, unset falls back to a key derived from
# INTEGRATION_ENCRYPTION_KEY. Keep a copy in your secret store: losing it makes every
# envelope credential unrecoverable. A malformed value stops the server at startup.
# See apps/dev/README.md, "Keychain".
KEYCHAIN_MASTER_KEY=
# Master key rotation only: the key being replaced. Unwrapping tries KEYCHAIN_MASTER_KEY
# first, then this one. Drop it once nothing is left under it.
KEYCHAIN_MASTER_KEY_PREVIOUS=
# Nightly upgrade of legacy credentials to envelope encryption. Built but OFF: it does
# nothing unless this is exactly "true". Do NOT enable until every direct
# decrypt(row.credentials) reader dual-reads (see docs/runbooks/keychain-jobs.md).
KEYCHAIN_LEGACY_UPGRADE_ENABLED=
# GitHub Integration
GITHUB_APP_ID
GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET
GITHUB_APP_WEBHOOK_SECRET
GITHUB_APP_PRIVATE_KEY
GITHUB_APP_SLUG
# Set to `true` to enable mid-session installation-id recovery on the
# /api/integrations/:id/github-token route. When on, a `?repo=owner/name`
# hint from the caller triggers install re-discovery on stale-cache 404.
# Default off — the legacy just-in-time mint path is unchanged.
GITHUB_APP_INSTALLATION_RECOVERY_ENABLED=false

# Slack Integration
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Id of the Maskin ops workspace. The VAT-correct-checkout state machine's
# `charge.dispute.created` handler DMs Sebk (spec Delta 5) through that
# workspace's active Slack integration. Leave unset in local dev to skip the
# DM (the handler logs an error and still emits the PostHog event).
MASKIN_OPS_WORKSPACE_ID=
# Public PNG URL for the Maskin app avatar, used as the `icon_url` on every
# agent post via the Slack MCP. Leave unset to use the Slack app's installed icon.
MASKIN_MACHINE_ICON_URL=

# Linear Integration
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=

# LinkedIn Integration (via LinkedIn Hosted Auth v2)
# Maskin reaches LinkedIn through an authenticated intermediary — customers
# connect their LinkedIn identity through its hosted wizard, Maskin
# stores only the resulting `account_id` (LinkedIn tokens never touch our
# infrastructure), and every downstream call to LinkedIn carries the
# workspace-agnostic UNIPILE_API_KEY plus the connected account_id.
# See apps/dev/src/lib/integrations/providers/linkedin-unipile/ and the
# First-party LinkedIn MCP bet's technical spec.
#
# UNIPILE_BASE_URL — LinkedIn provider v2 REST API base. Docs default is
#     `https://api.unipile.com`; a tenant may issue a tenant-subdomain host
#     instead. The value must NOT include the `/v2` path suffix — the client
#     concatenates the path. See https://developer.unipile.com/v2.0/docs.
# UNIPILE_API_KEY — the single Maskin-owned API key sent as `X-API-KEY`.
# UNIPILE_WEBHOOK_SECRET — Unipile v2's per-endpoint signing secret
#     (`wes_...`, returned by POST /v2/webhooks/endpoints/ at endpoint
#     creation and viewable in the Unipile dashboard). Required by the
#     `POST /api/integrations/linkedin-unipile/webhook` route (R11-C
#     fan-out re-enumeration on `account.reconnect`), which verifies the
#     `unipile-signature` HMAC-SHA256 header against this secret. Docs:
#     https://developer.unipile.com/v2.0/docs/configure-a-webhook.
#     Note: this secret is per-webhook-endpoint, not per-application — if
#     you rotate the webhook, get a fresh secret and redeploy.
UNIPILE_BASE_URL=https://api.unipile.com
UNIPILE_API_KEY=
UNIPILE_WEBHOOK_SECRET=

# Public base URL of this Maskin API instance. Used to build the callback
# URL passed to LinkedIn v2 as `redirect_uri` at auth-link creation time
# (`{MASKIN_PUBLIC_URL}/api/integrations/linkedin-unipile/callback`) and to
# build the post-callback redirect back to Settings > Integrations.
# Defaults to http://localhost:3000 in local dev.
MASKIN_PUBLIC_URL=

# Maskin-funded OpenRouter account. This single key underwrites two routes:
#   1) the per-actor system fallback (workspaces with no key configured),
#   2) paid Maskin LLM subscriptions (settings.billing.plan ∈ pro/team).
# Recommended model: `deepseek/deepseek-v4-flash` (1,05M ctx, agentic-tuned,
# Input: $0,14/M tokens, Output: $0,28/M tokens). Leave the key blank to
# disable both the fallback and the paid-plan route.
MASKIN_FALLBACK_OPENROUTER_KEY=
MASKIN_FALLBACK_BASE_URL=https://openrouter.ai/api
MASKIN_FALLBACK_MODEL=deepseek/deepseek-v4-flash
MASKIN_FALLBACK_SMALL_MODEL=deepseek/deepseek-v4-flash
# Speech-to-text model for chat dictation (same OpenRouter key as above).
# Default mistralai/voxtral-small-transcribe-3-0; the cheaper alternative is
# mistralai/voxtral-mini-transcribe-3-0.
# MASKIN_TRANSCRIPTION_MODEL=mistralai/voxtral-small-transcribe-3-0
# Send dictation audio through OpenRouter's EU in-region endpoint (decrypted and
# routed only inside EU/EEA/UK/CH; fails closed). Needs an OpenRouter Business
# or Enterprise plan. Defaults to MASKIN_FALLBACK_BASE_URL.
# MASKIN_TRANSCRIPTION_BASE_URL=https://eu.openrouter.ai/api
# Set to true or 1 to send provider.zdr on the funded in-process chat calls
# (OpenRouter then only routes to zero-retention hosts). Default off.
MASKIN_FALLBACK_ZDR=false
# The only OpenRouter providers allowed to serve a funded request (comma separated
# provider slugs). Sent as provider.only on chat calls and, via the agent
# container's local proxy, on every agent session request. Unset uses the built-in
# list (digitalocean,gmicloud); set to empty or none to allow any provider.
# MASKIN_FALLBACK_PROVIDER_ONLY=digitalocean,gmicloud
# Time-to-first-token guard for agent sessions on the funded route, in ms. A streamed
# request with no token after this long is cancelled and retried once, then sent to
# the other provider in MASKIN_FALLBACK_PROVIDER_ONLY (two tries). The last
# try has no timeout, so a request that is slow everywhere is still served. Unset
# uses 8000; set to 0 or none to turn the guard off.
# MASKIN_FALLBACK_TTFT_TIMEOUT_MS=8000
# OpenRouter providers that must never serve a funded request (comma separated,
# names as OpenRouter spells them). Sent as provider.ignore on chat calls and,
# via the agent container's local proxy, on every agent session request.
MASKIN_FALLBACK_PROVIDER_IGNORE=CoreWeave
# Models that cannot read images (comma separated, matched as substrings of the model
# id). Sessions on a match get image blocks swapped for a text note. Unset uses the
# built-in list (deepseek). Set to empty or none to turn image stripping off.
# MASKIN_TEXT_ONLY_MODELS=deepseek
# Interactive chat only: when a session's model keeps returning an empty reply,
# the turn is retried once on this model before the user is told to try again.
# An OpenRouter slug in the same family as the session's model (the fallback is
# skipped when the vendor prefixes differ). Leave blank to disable the fallback.
CHAT_EMPTY_TURN_FALLBACK_MODEL=
# Per-actor daily input+output token cap. ~500k ≈ $0.20/user/day worst case.
MASKIN_FALLBACK_DAILY_TOKEN_LIMIT=550000

# Comma-separated actor UUIDs designated enterprise on every workspace they
# bill-own: exempt from every plan-tier limit (seat cap, ownership cap, $ hard
# cap, credit debiting) and entitled to BYO-LLM, so a Claude Pro/Max
# subscription can be imported without a per-workspace `enterprise_granted`
# flip. This is also the only thing that confers ops rights to grant
# `enterprise_granted` to others. Leave blank in every non-founder deployment.
MASKIN_ENTERPRISE_ACTOR_IDS=

# Test-only seam. When set, mounts POST /api/test-grants/:id, which lets an
# authenticated caller presenting this exact token in `X-Test-Grant-Token`
# grant a workspace a paid plan tier or enterprise status. Both are
# deliberately not self-service in the product (Stripe owns `settings.billing`;
# `enterprise_granted` needs an ops actor), and E2E has no DB access, so this is how
# specs set up those states. MUST stay blank in production: the route is not
# registered at all when it is unset.
MASKIN_TEST_GRANT_TOKEN=

# Gmail Integration
# OAuth2 Client ID + Secret from Google Cloud Console (project: sindre-430307)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Pub/Sub topic that receives Gmail push notifications.
# Format: projects/<project-id>/topics/<topic-name>
GMAIL_PUBSUB_TOPIC=
# Audience claim verified on incoming Pub/Sub push JWTs.
# Set this to the push endpoint URL configured on the subscription
# (e.g. https://<your-host>/api/webhooks/gmail).
GMAIL_PUBSUB_AUDIENCE=
# Service account email configured on the Pub/Sub push subscription.
# Pinning this prevents arbitrary Google service accounts from forging webhooks
# by minting OIDC tokens with the matching audience.
GMAIL_PUBSUB_SERVICE_ACCOUNT=

# Stripe — Maskin LLM subscription billing
# Secret key (sk_test_… in dev, sk_live_… in prod) and the webhook signing
# secret from the Stripe Dashboard. Price IDs come from the Stripe products
# (Pro $49/mo, Team $200/mo).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# Apple Developer Team ID (10 chars). Enables /.well-known/apple-app-site-association for the native app.
APPLE_TEAM_ID=
# Price id backing the maskin_credits_custom Product — the "customer picks the
# number" credit top-up Price whose Product carries the tax_code Stripe Tax
# classifies against. Test-mode and live-mode Products are separate Stripe
# objects with different ids, so set it per environment (there is no code-side
# fallback). Optional: leave blank to disable the credit top-up, in which case
# POST /billing/credits/checkout returns 404 and subscription checkout is
# unaffected.
STRIPE_PRICE_CREDITS_CUSTOM=
# Optional: Stripe Price ID for the $49/connected-identity/month LinkedIn
# Identity add-on. Create a Product + Price in the Stripe Dashboard
# at $49/month (USD) and paste the resulting `price_…` id here. Leaving this
# blank is safe: the plan surface reads only the connected-credential count to
# decide whether to render the add-on line; a blank price id doesn't break anything until an operator wires
# checkout for it (out of scope in the initial SKU-visibility PR).
# STRIPE_PRICE_LINKEDIN_IDENTITY — recurring $49/month (USD) Price for ONE
#     connected LinkedIn identity. Quantity = the workspace's count of active
#     `linkedin-unipile` integrations. On pro/team it is added as an item on
#     the plan subscription (same invoice, same anniversary); on trial the
#     workspace gets its own single-line subscription via its own Checkout.
#     Optional: unset means the add-on cannot be billed and connecting logs a
#     warning instead of failing — see lib/linkedin-addon-billing.ts.
STRIPE_PRICE_LINKEDIN_IDENTITY=
# Trial hard cap, in USD cents — used by the LLM router to gate calls once the
# period's actual dollar cost (not a token count, since different agents can
# run different model tiers with different $/token ratios) is spent. The trial
# gets $10. This value must stay in sync with TRIAL_HARD_CAP_DEFAULT_USD_CENTS
# in apps/dev/src/lib/billing-defaults.ts.
# Pro and Team caps are NOT env-configurable: they come from
# PRO_/TEAM_HARD_CAP_DEFAULT_USD_CENTS in that file, so a stale env value can
# never pin a paying plan below its price.
MASKIN_TRIAL_HARD_CAP_USD_CENTS=1000

# Google Calendar Integration
# OAuth2 Client ID + Secret from Google Cloud Console. Same Google Cloud project
# as Gmail is fine, but the OAuth client must have the Calendar scopes
# (calendar.readonly + calendar.events + userinfo.email + openid) enabled.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Google Drive Integration
# OAuth2 Client ID + Secret for Google Drive. Same Google Cloud project as Meet /
# Gmail / Google Calendar; distinct OAuth client (titled "Maskin Google Drive")
# with the Drive API enabled and the single scope set openid + userinfo.email +
# drive (a Google-restricted scope; unverified-first). See
# apps/dev/src/lib/integrations/providers/google-drive/ and the Google Drive MCP
# tech spec §1 + §3. Set by the separate Google Cloud setup task, not by code.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# HMAC key for the token Google echoes back in X-Goog-Channel-Token on every Drive
# change notification (HMAC-SHA256 of the channel id). Any long random string;
# rotating it orphans open channels until the renewer replaces them. Channels
# deliver to {MASKIN_PUBLIC_URL}/api/webhooks/google-drive, so MASKIN_PUBLIC_URL
# must be the public https origin of this API.
GOOGLE_DRIVE_CHANNEL_TOKEN_SECRET=

# Google Meet Integration
# OAuth2 Client ID + Secret from Google Cloud Console. Same Google Cloud project
# as Gmail + Google Calendar; distinct OAuth client (titled "Maskin Google Meet")
# with the Meet scopes enabled: openid + userinfo.email +
# meetings.space.readonly + meetings.space.created. See
# apps/dev/src/lib/integrations/providers/google-meet/ and the Google Meet MCP
# reshape tech spec §1 + §9. Both Meet scopes are Google-classified sensitive;
# ship-plan is unverified-first with the OAuth consent-screen whitelist covering
# internal + friendly-customer domains until Google verification lands (3–6wk async).
GOOGLE_MEET_CLIENT_ID=
GOOGLE_MEET_CLIENT_SECRET=
# Pub/Sub topic that receives Google Meet Workspace Events pushes
# (conference.ended + transcript.fileGenerated + recording.fileGenerated).
# Format: projects/<project-id>/topics/<topic-name>. Shared across all connected
# customer workspaces — per-workspace fan-out happens at the webhook via the
# People-id stored on each `integrations` row (see reshape tech spec §4).
GOOGLE_MEET_PUBSUB_TOPIC=
# Audience claim verified on incoming Pub/Sub push JWTs. Set this to the push
# endpoint URL configured on the subscription — for prod:
# https://<maskin-api>/api/integrations/webhooks/google-meet.
GOOGLE_MEET_PUBSUB_AUDIENCE=
# Service account email configured on the Pub/Sub push subscription. Pinning
# this prevents arbitrary Google service accounts from forging webhooks by
# minting OIDC tokens with the matching audience. Same shape as
# GMAIL_PUBSUB_SERVICE_ACCOUNT; the push subscription's service account also
# needs `roles/iam.serviceAccountTokenCreator` on the project (matches Gmail).
GOOGLE_MEET_PUBSUB_SERVICE_ACCOUNT=

# Google Search Console Integration
# OAuth2 Client ID + Secret from Google Cloud Console. Set to the SAME values
# as GMAIL_CLIENT_ID / GOOGLE_CALENDAR_CLIENT_ID — Search Console reuses the
# shared Google OAuth client (same Google Cloud project, same consent screen).
# Two Console steps are needed on that client before Connect works: enable the
# `webmasters.readonly` scope, and add this redirect URI to its authorized
# redirect URIs: {MASKIN_PUBLIC_URL}/api/integrations/google-search-console/callback
# No other Google surface is requested. No separate consent screen required.
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=

# PostHog (frontend analytics — apps/web)
# Project token from PostHog → Settings → Project. Leave blank in local dev
# to fall back to console.info-only analytics.
VITE_POSTHOG_KEY=
# Default: https://eu.i.posthog.com (EU cloud, project 191282).
VITE_POSTHOG_HOST=

# PostHog (backend analytics + runtime telemetry — apps/dev)
# Project API key from PostHog → Settings → Project → Project API Key. Same
# project as VITE_POSTHOG_KEY (eu, project 191282). Required for backend events
# like `slack.message.posted`, and used by `RuntimeTelemetry` to emit
# `runtime_session_started`, `runtime_session_ended`,
# `runtime_concurrent_sessions_gauge`, and `runtime_cross_session_check` for the
# Scalable Agent Session Infrastructure bet's ship metric. Leave blank to skip
# capture and disable runtime telemetry in local dev (every emit becomes a no-op).
POSTHOG_API_KEY=
# Default: https://eu.i.posthog.com (EU cloud, project 191282).
POSTHOG_HOST=

# PostHog read access (scripts/posthog/* — query API, NOT event capture).
# POSTHOG_PROJECT_ID is the numeric id (191282 for the EU project).
# POSTHOG_PERSONAL_API_KEY is a read-scoped Personal API Key from
# PostHog → Account → Personal API Keys. Distinct from POSTHOG_API_KEY,
# which is the write-only project capture key and cannot run queries.
POSTHOG_PROJECT_ID=191282
POSTHOG_PERSONAL_API_KEY=

# Sentry error tracking. Each app has its own Sentry project/DSN. Leave blank
# in local dev — Sentry.init() is skipped and captures become no-ops. Even with
# a DSN set, apps/dev and apps/agent-server only report when NODE_ENV=production
# and apps/web only reports from a production build (import.meta.env.PROD) —
# so a stray DSN in a local .env never leaks local/dev activity.
# apps/dev (backend API) — DSN from Sentry project "maskin-dev".
SENTRY_DSN_DEV=
# apps/agent-server (microsandbox runtime) — DSN from
# Sentry project "maskin-agent-server". Also needs to land in
# apps/agent-server/.env on the host (see EnvironmentFile in
# apps/agent-server/systemd/maskin-agent-server.service) since that process
# isn't started via turbo/pnpm dev on a deployed box.
SENTRY_DSN_AGENT_SERVER=
# apps/web (frontend) — DSN from Sentry project "maskin-web".
VITE_SENTRY_DSN=

# Temporary escape hatches to verify the Sentry pipeline from a local dev box
# without flipping NODE_ENV=production (which also gates unrelated prod-only
# behavior). Set alongside the DSN above for a one-off test, then unset both —
# do not leave enabled in a local .env.
SENTRY_FORCE_ENABLE=
VITE_SENTRY_FORCE_ENABLE=

# Trusted proxy CIDRs for X-Forwarded-For validation (public landing-page routes).
# Comma-separated list of CIDR blocks that are allowed to set XFF headers.
# Default: 127.0.0.1/32,::1/128 (loopback only — safe for dev).
# In production, set this to your edge/CDN IP ranges (e.g. Cloudflare CIDRs).
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# OCI image used for agent sessions dispatched to apps/agent-server (microsandbox).
# In production, set this to the full registry path (e.g. magnusnoeddegaard/agent-base:latest).
# Leave unset in local dev — Docker builds agent-base:latest from docker/agent-base/.
AGENT_BASE_IMAGE=

# Rollback for the stdio tool-server environment scrub in docker/agent-base/agent-run.sh.
# Each stdio tool server is launched without MASKIN_API_KEY, MASKIN_API_URL,
# MASKIN_WORKSPACE_ID and the GITHUB_TOKEN* variables unless its own env block names them.
# Set to "off" to give tool servers the full environment again from the next session on.
# Leave unset for the default (scrub on).
MASKIN_MCP_ENV_SCRUB=

# apps/agent-server: tunnels from an agent's computer to dev servers in its session
# sandbox (desktop_expose_port). Each computer gets its own block of
# DESKTOP_RELAY_BLOCK_SIZE host-loopback ports out of [START, END] when it is created,
# and its firewall allows only that block. The block size is the most ports one agent
# can expose at once and cannot change for a computer that already exists.
# AGENT_SERVER_SSH_KEY_PATH=/root/.agent-server/ssh/relay_key
# DESKTOP_RELAY_PORT_START=20000
# DESKTOP_RELAY_PORT_END=21999
# DESKTOP_RELAY_BLOCK_SIZE=8

# Resend — transactional email (workspace invites)
# API key from resend.com → API Keys. Leave blank in local dev — the send
# helper logs the intended email to console instead of dispatching, so the
# accept-invite flow can be exercised end-to-end without wiring Resend up.
RESEND_API_KEY=
# From-address on invite emails. Must be on a domain with SPF + DKIM
# verified in Resend. Recommended: notifications@maskin.io (see spec §Ops).
EMAIL_FROM=
# Base URL for the frontend, used to build accept-invite links, e.g.
# https://maskin.io. No trailing slash.
APP_URL=

# Feature flags (backend-driven)
# Resolved per-actor by the backend at runtime and served from
# GET /api/feature-flags. Deliberately NOT VITE_-prefixed — the tester actor
# ids stay server-side and are never shipped to the browser, and turning a
# feature on or off is an env change + restart, not a frontend rebuild.
# Both are comma-separated and optional; empty means every flag is off for
# everyone. Values are trimmed and empty entries dropped; actor ids compare
# case-insensitively.
# A flag has two states: off, or on for the tester actors. To ship a feature to
# everyone you delete its flag (remove the boundary in the UI, drop the id from
# FLAGS in apps/dev/src/lib/feature-flags.ts, and remove it here) rather than
# promoting it to a list that only ever grows.
# Known flag ids live in apps/dev/src/lib/feature-flags.ts; anything else here
# is ignored.
#
# Actor ids of the testers who get early access.
FF_TESTER_ACTOR_IDS=
# Flag ids those testers see, e.g. `some-flag`. Must be
# registered in FLAGS to have any effect.
FF_TESTER_FEATURES=

# ── One-off backfills ───────────────────────────────────────────────────────
# Set to 1 for ONE deploy to give every existing agent in every workspace its default daily
# Heartbeat, then remove it. Runs once per database (a done marker is kept in _migrations), so a
# second boot with it still set does nothing. Look for "Default Heartbeat boot backfill done" in the
# logs: it carries the eligible, created and reworded counts.
RUN_HEARTBEAT_BACKFILL=
# Set to dry for one deploy to log which workspaces would get the draft-approval-tasks skill
# (nothing is written), then to 1 for ONE deploy to add it, then remove it. Workspaces that already
# have a skill with that name are never touched. Look for "Draft approval skill boot backfill" in the
# logs: it carries workspaces, seeded, skipped, failed and the seeded workspace ids.
RUN_DRAFT_APPROVAL_SKILL_BACKFILL=

# ── Sessions ────────────────────────────────────────────────────────────────
# Minutes an interactive chat session may sit with no activity before the
# watchdog closes it and frees its agent-server slot. Whole minutes, 1..1440.
# Unset or invalid falls back to 15.
# CHAT_IDLE_CLOSE_MINUTES=15

# ── Voice calls ─────────────────────────────────────────────────────────────
# Operator-owned OpenAI key that bills voice calls (OpenAI Realtime). Voice is on
# for everyone, so without it the Call button shows but every call fails at start
# with "Voice is not configured on this server". Boot logs a warning when unset.
MASKIN_VOICE_OPENAI_API_KEY=
# Optional. The agent's voice on new calls. One of alloy, ash, ballad, coral, echo, sage,
# shimmer, verse, marin, cedar (marin and cedar are the ones OpenAI recommends). Unset or
# anything else uses verse. Read per call, so a changed value applies to the next call.
# MASKIN_VOICE_REALTIME_VOICE=verse
# Optional. How soon the model takes its turn once the person pauses: low, medium, high or
# auto (auto = medium). Unset or anything else uses medium. Read per call.
# MASKIN_VOICE_VAD_EAGERNESS=medium
# Optional. The model's thinking effort per turn: minimal, low, medium, high, xhigh, or off to
# send no setting. Unset or anything else uses low. Read per call.
# MASKIN_VOICE_REASONING_EFFORT=low
# Optional. Which tools the voice model holds itself. core (default): a handful of everyday tools
# plus ask_workspace, which runs any other request with the full toolkit through a text model.
# full: every tool is pinned on the voice model (the old behaviour; use it to roll back). Read per call.
# MASKIN_VOICE_TOOL_MODE=core
# Optional. The text model behind ask_workspace (OpenAI chat completions, billed to the voice key).
# Unset uses gpt-4.1. Read per call.
# MASKIN_VOICE_DELEGATE_MODEL=gpt-4.1

# ── APNs push (native Apple apps) ───────────────────────────────────────────
# Token-based auth. If APNS_KEY_ID / APNS_TEAM_ID / APNS_PRIVATE_KEY are unset
# push is disabled (logged once at startup of the first send) and nothing fails.
# Create a key at developer.apple.com → Keys → Apple Push Notifications service.
APNS_KEY_ID=
APNS_TEAM_ID=
# Contents of the .p8 file; literal "\n" escapes are accepted for single-line env.
APNS_PRIVATE_KEY=
# apns-topic; defaults to io.maskin.app
APNS_BUNDLE_ID=io.maskin.app

# ── Scheduled pushes ────────────────────────────────────────────────────────
# Daily briefing push (needs the actor's notification_preferences.timezone to be set by the app).
# On by default; set to 0 to disable without a deploy.
# FEATURE_BRIEFING_PUSH=0
# New-user lifecycle pushes (first agent result, 24h decision reminder, day-3 nudge).
# OFF by default; set to 1 (or true) to enable.
# PUSH_LIFECYCLE_ENABLED=1

# ── Web Push (browsers: Chrome, Edge, Firefox, Safari) ──────────────────────
# VAPID keys identify this server to the browsers' push services. If any of the
# three is unset browser push is disabled and the Profile toggle is hidden.
# Generate a pair once with `npx web-push generate-vapid-keys` and keep it
# stable: rotating it invalidates every existing browser subscription.
# The public key is served to the browser by GET /api/web-push/config, so it
# needs no VITE_ variable and no Dockerfile ARG.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: or https:// contact the push services can reach, e.g. mailto:ops@example.com
VAPID_SUBJECT=

# Optional: how long (ms) authMiddleware caches API-key and workspace-membership
# lookups per process. Default 10000; 0 disables. Key rotation, actor deletion
# and member removal evict immediately; any other revocation waits out the TTL.
# AUTH_CACHE_TTL_MS=10000

# Local dev only: set to `false` to skip the dev auto-bootstrap (default
