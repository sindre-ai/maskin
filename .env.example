DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maskin
# Optional: overrides DATABASE_URL
# POSTGRES_URL=
# Optional: direct (non-pooled) connection for PG LISTEN/NOTIFY when using a connection pooler
# DATABASE_URL_DIRECT=

# Integration secrets encryption key (32-byte hex, 64 chars).
# Auto-generated by `pnpm dev` / `pnpm dev:win` if missing. Required to encrypt stored OAuth tokens.
INTEGRATION_ENCRYPTION_KEY=

# GitHub Integration
GITHUB_APP_ID
GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET
GITHUB_APP_WEBHOOK_SECRET
GITHUB_APP_PRIVATE_KEY
GITHUB_APP_SLUG
# Set to `true` to enable mid-session installation-id recovery on the
# /api/integrations/:id/github-token route. When on, a `?repo=owner/name`
# hint from the caller triggers install re-discovery on stale-cache 404.
# Default off — the legacy just-in-time mint path is unchanged.
GITHUB_APP_INSTALLATION_RECOVERY_ENABLED=false

# Slack Integration
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Public PNG URL for the Machine app avatar, used as the `icon_url` on every
# agent post via the Slack MCP. Leave unset to use the Slack app's installed icon.
MASKIN_MACHINE_ICON_URL=

# Linear Integration
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=

# Maskin-funded OpenRouter account. This single key underwrites two routes:
#   1) the per-actor system fallback (workspaces with no key configured),
#   2) paid Maskin LLM subscriptions (settings.billing.plan ∈ starter/pro).
# Recommended model: `deepseek/deepseek-v4-flash` (1,05M ctx, agentic-tuned,
# Input: $0,14/M tokens, Output: $0,28/M tokens). Leave the key blank to
# disable both the fallback and the paid-plan route.
MASKIN_FALLBACK_OPENROUTER_KEY=
MASKIN_FALLBACK_BASE_URL=https://openrouter.ai/api
MASKIN_FALLBACK_MODEL=deepseek/deepseek-v4-flash
MASKIN_FALLBACK_SMALL_MODEL=deepseek/deepseek-v4-flash
# Per-actor daily input+output token cap. ~500k ≈ $0.20/user/day worst case.
MASKIN_FALLBACK_DAILY_TOKEN_LIMIT=550000

# Gmail Integration
# OAuth2 Client ID + Secret from Google Cloud Console (project: sindre-430307)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Pub/Sub topic that receives Gmail push notifications.
# Format: projects/<project-id>/topics/<topic-name>
GMAIL_PUBSUB_TOPIC=
# Audience claim verified on incoming Pub/Sub push JWTs.
# Set this to the push endpoint URL configured on the subscription
# (e.g. https://<your-host>/api/webhooks/gmail).
GMAIL_PUBSUB_AUDIENCE=
# Service account email configured on the Pub/Sub push subscription.
# Pinning this prevents arbitrary Google service accounts from forging webhooks
# by minting OIDC tokens with the matching audience.
GMAIL_PUBSUB_SERVICE_ACCOUNT=

# Stripe — Maskin LLM subscription billing
# Secret key (sk_test_… in dev, sk_live_… in prod) and the webhook signing
# secret from the Stripe Dashboard. Price IDs come from the Stripe products
# (Starter $20/mo, Pro $60/mo).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
# Hard caps per plan, used by the LLM router to gate calls once the period's
# tokens are spent. Sized off Deepseek v4 Flash worst-case cost ≤ $16 (Starter)
# and ≤ $48 (Pro) to keep gross margin ≥20%. These values must stay in sync
# with STARTER_HARD_CAP_DEFAULT_TOKENS / PRO_HARD_CAP_DEFAULT_TOKENS in
# apps/dev/src/lib/billing-defaults.ts and the literals pinned in
# apps/web/src/__tests__/components/settings/billing-section.test.tsx.
MASKIN_STARTER_HARD_CAP_TOKENS=32000000
MASKIN_PRO_HARD_CAP_TOKENS=96000000

# Google Calendar Integration
# OAuth2 Client ID + Secret from Google Cloud Console. Same Google Cloud project
# as Gmail is fine, but the OAuth client must have the Calendar scopes
# (calendar.readonly + calendar.events + userinfo.email + openid) enabled.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# PostHog (frontend analytics — apps/web)
# Project token from PostHog → Settings → Project. Leave blank in local dev
# to fall back to console.info-only analytics.
VITE_POSTHOG_KEY=
# Default: https://eu.i.posthog.com (EU cloud, project 191282).
VITE_POSTHOG_HOST=

# PostHog (backend analytics + runtime telemetry — apps/dev)
# Project API key from PostHog → Settings → Project → Project API Key. Same
# project as VITE_POSTHOG_KEY (eu, project 191282). Required for backend events
# like `slack.message.posted`, and used by `RuntimeTelemetry` to emit
# `runtime_session_started`, `runtime_session_ended`,
# `runtime_concurrent_sessions_gauge`, and `runtime_cross_session_check` for the
# Scalable Agent Session Infrastructure bet's ship metric. Leave blank to skip
# capture and disable runtime telemetry in local dev (every emit becomes a no-op).
POSTHOG_API_KEY=
# Default: https://eu.i.posthog.com (EU cloud, project 191282).
POSTHOG_HOST=

# PostHog read access (scripts/posthog/* — query API, NOT event capture).
# POSTHOG_PROJECT_ID is the numeric id (191282 for the EU project).
# POSTHOG_PERSONAL_API_KEY is a read-scoped Personal API Key from
# PostHog → Account → Personal API Keys. Distinct from POSTHOG_API_KEY,
# which is the write-only project capture key and cannot run queries.
POSTHOG_PROJECT_ID=191282
POSTHOG_PERSONAL_API_KEY=

# Trusted proxy CIDRs for X-Forwarded-For validation (public landing-page routes).
# Comma-separated list of CIDR blocks that are allowed to set XFF headers.
# Default: 127.0.0.1/32,::1/128 (loopback only — safe for dev).
# In production, set this to your edge/CDN IP ranges (e.g. Cloudflare CIDRs).
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# OCI image used for agent sessions dispatched to apps/agent-server (microsandbox).
# In production, set this to the full registry path (e.g. magnusnoeddegaard/agent-base:latest).
# Leave unset in local dev — Docker builds agent-base:latest from docker/agent-base/.
AGENT_BASE_IMAGE=

# OCI image used for browser sidecars. In production, set this to the same
# registry path configured as GitHub Actions var BROWSER_SIDECAR_IMAGE.
# Leave unset in local dev — Docker builds browser-sidecar:latest locally.
BROWSER_SIDECAR_IMAGE=
