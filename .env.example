DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maskin
# Optional: overrides DATABASE_URL
# POSTGRES_URL=
# Optional: direct (non-pooled) connection for PG LISTEN/NOTIFY when using a connection pooler
# DATABASE_URL_DIRECT=

# Integration secrets encryption key (32-byte hex, 64 chars).
# Auto-generated by `pnpm dev` / `pnpm dev:win` if missing. Required to encrypt stored OAuth tokens.
INTEGRATION_ENCRYPTION_KEY=

# GitHub Integration
GITHUB_APP_ID
GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET
GITHUB_APP_WEBHOOK_SECRET
GITHUB_APP_PRIVATE_KEY
GITHUB_APP_SLUG
# Set to `true` to enable mid-session installation-id recovery on the
# /api/integrations/:id/github-token route. When on, a `?repo=owner/name`
# hint from the caller triggers install re-discovery on stale-cache 404.
# Default off — the legacy just-in-time mint path is unchanged.
GITHUB_APP_INSTALLATION_RECOVERY_ENABLED=false

# Slack Integration
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Public PNG URL for the Machine app avatar, used as the `icon_url` on every
# agent post via the Slack MCP. Leave unset to use the Slack app's installed icon.
MASKIN_MACHINE_ICON_URL=

# Linear Integration
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=

# Cheap fallback model — when a workspace has no Claude OAuth, no anthropic
# API key, and no custom_llm config, sessions are routed to this OpenRouter
# endpoint with a per-actor daily token quota. Recommended model:
# `deepseek/deepseek-v4-flash` (1,05M ctx, agentic-tuned, Input: $0,14/M tokens, Output: $0,28/M tokens)
# Leave the key blank to disable the system fallback entirely.
MASKIN_FALLBACK_OPENROUTER_KEY=
MASKIN_FALLBACK_BASE_URL=https://openrouter.ai/api
MASKIN_FALLBACK_MODEL=deepseek/deepseek-v4-flash
MASKIN_FALLBACK_SMALL_MODEL=deepseek/deepseek-v4-flash
# Per-actor daily input+output token cap. ~500k ≈ $0.20/user/day worst case.
MASKIN_FALLBACK_DAILY_TOKEN_LIMIT=550000

# Gmail Integration
# OAuth2 Client ID + Secret from Google Cloud Console (project: sindre-430307)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Pub/Sub topic that receives Gmail push notifications.
# Format: projects/<project-id>/topics/<topic-name>
GMAIL_PUBSUB_TOPIC=
# Audience claim verified on incoming Pub/Sub push JWTs.
# Set this to the push endpoint URL configured on the subscription
# (e.g. https://<your-host>/api/webhooks/gmail).
GMAIL_PUBSUB_AUDIENCE=
# Service account email configured on the Pub/Sub push subscription.
# Pinning this prevents arbitrary Google service accounts from forging webhooks
# by minting OIDC tokens with the matching audience.
GMAIL_PUBSUB_SERVICE_ACCOUNT=

# Google Calendar Integration
# OAuth2 Client ID + Secret from Google Cloud Console. Same Google Cloud project
# as Gmail is fine, but the OAuth client must have the Calendar scopes
# (calendar.readonly + calendar.events + userinfo.email + openid) enabled.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# PostHog (frontend analytics — apps/web)
# Project token from PostHog → Settings → Project. Leave blank in local dev
# to fall back to console.info-only analytics.
VITE_POSTHOG_KEY=
# Default: https://eu.i.posthog.com (EU cloud, project 191282).
VITE_POSTHOG_HOST=

# PostHog (backend analytics + runtime telemetry — apps/dev)
# Project API key from PostHog → Settings → Project → Project API Key. Same
# project as VITE_POSTHOG_KEY (eu, project 191282). Required for backend events
# like `slack.message.posted`, and used by `RuntimeTelemetry` to emit
# `runtime_session_started`, `runtime_session_ended`,
# `runtime_concurrent_sessions_gauge`, and `runtime_cross_session_check` for the
# Scalable Agent Session Infrastructure bet's ship metric. Leave blank to skip
# capture and disable runtime telemetry in local dev (every emit becomes a no-op).
POSTHOG_API_KEY=
# Default: https://eu.i.posthog.com (EU cloud, project 191282).
POSTHOG_HOST=

# PostHog read access (scripts/posthog/* — query API, NOT event capture).
# POSTHOG_PROJECT_ID is the numeric id (191282 for the EU project).
# POSTHOG_PERSONAL_API_KEY is a read-scoped Personal API Key from
# PostHog → Account → Personal API Keys. Distinct from POSTHOG_API_KEY,
# which is the write-only project capture key and cannot run queries.
POSTHOG_PROJECT_ID=191282
POSTHOG_PERSONAL_API_KEY=

# Sentry error tracking. Each app has its own Sentry project/DSN. Leave blank
# in local dev — Sentry.init() is skipped and captures become no-ops. Even with
# a DSN set, apps/dev and apps/agent-server only report when NODE_ENV=production
# and apps/web only reports from a production build (import.meta.env.PROD) —
# so a stray DSN in a local .env never leaks local/dev activity.
# apps/dev (backend API) — DSN from Sentry project "maskin-dev".
SENTRY_DSN_DEV=
# apps/agent-server (microsandbox runtime + browser sidecars) — DSN from
# Sentry project "maskin-agent-server". Also needs to land in
# apps/agent-server/.env on the host (see EnvironmentFile in
# apps/agent-server/systemd/maskin-agent-server.service) since that process
# isn't started via turbo/pnpm dev on a deployed box.
SENTRY_DSN_AGENT_SERVER=
# apps/web (frontend) — DSN from Sentry project "maskin-web".
VITE_SENTRY_DSN=

# Temporary escape hatches to verify the Sentry pipeline from a local dev box
# without flipping NODE_ENV=production (which also gates unrelated prod-only
# behavior). Set alongside the DSN above for a one-off test, then unset both —
# do not leave enabled in a local .env.
SENTRY_FORCE_ENABLE=
VITE_SENTRY_FORCE_ENABLE=

# Trusted proxy CIDRs for X-Forwarded-For validation (public landing-page routes).
# Comma-separated list of CIDR blocks that are allowed to set XFF headers.
# Default: 127.0.0.1/32,::1/128 (loopback only — safe for dev).
# In production, set this to your edge/CDN IP ranges (e.g. Cloudflare CIDRs).
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# OCI image used for agent sessions dispatched to apps/agent-server (microsandbox).
# In production, set this to the full registry path (e.g. magnusnoeddegaard/agent-base:latest).
# Leave unset in local dev — Docker builds agent-base:latest from docker/agent-base/.
AGENT_BASE_IMAGE=

# OCI image used for browser sidecars. In production, set this to the same
# registry path configured as GitHub Actions var BROWSER_SIDECAR_IMAGE.
# Leave unset in local dev — Docker builds browser-sidecar:latest locally.
BROWSER_SIDECAR_IMAGE=

# vaerksted-auth (apps/vaerksted-auth) — standalone identity service for
# Skjald device sync + cross-ecosystem login. See
# docs/design/vaerksted-auth-and-sync.md for the full design. Own service,
# own Postgres schema — NOT the same DATABASE_URL/postgres container Maskin
# itself uses.
#
# Connection string for vaerksted-auth's own Postgres schema — in production
# this is a dedicated Supabase project's Postgres (design doc §6a, §10), not
# the local dev `postgres` compose service.
VAERKSTED_AUTH_DATABASE_URL=
# Supabase Auth (GoTrue) admin client credentials for that same dedicated
# Supabase project — used to verify magic-link/OAuth credentials server-side.
# SUPABASE_SERVICE_ROLE_KEY is a secret; never expose it to a browser client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Ed25519 keypair (hex-encoded — see packages/vaerksted-crypto) vaerksted-auth
# uses as its own signing ("CA") key for device certs (design doc §6 step 3).
# Generate with `generateKeypair()` from @maskin/vaerksted-crypto. The
# private key must stay secret; the public key is also handed to any
# service (e.g. vaerksted-sync) that needs to verify device certs.
VAERKSTED_AUTH_SIGNING_PRIVATE_KEY=
VAERKSTED_AUTH_SIGNING_PUBLIC_KEY=
# HMAC secret (min 16 chars) for vaerksted-auth's short-lived session JWTs,
# issued by POST /identities and POST /sessions.
VAERKSTED_AUTH_SESSION_JWT_SECRET=

# Base URL Maskin's own backend (apps/dev) uses to call vaerksted-auth as an
# HTTP client (M5 — "Continue with vaerksted" account linking, see
# vaerksted-auth-and-sync.md §8 and the implementation plan's M5 section).
# Points at the vaerksted-auth service above, e.g. http://localhost:3001 in
# local dev or its deployed URL in production.
VAERKSTED_AUTH_BASE_URL=
# Opt-in gate (default unset/false): when set to a truthy value, POST
# /api/actors rejects new password-based signups and directs callers to the
# vaerksted-auth flow instead. Left unset by default because POST /api/actors
# is load-bearing for the documented local-dev bootstrap flow in the root
# CLAUDE.md (auto-provisions a dev@local actor on a fresh DB) — do not enable
# this in local dev.
VAERKSTED_AUTH_REQUIRED=

# vaerksted-auth's dedicated Supabase project, browser-facing half (apps/web
# "Continue with vaerksted" button — see apps/web/src/hooks/use-vaerksted-auth.ts).
# These are the anon/public credentials for the Supabase project referenced by
# SUPABASE_URL above — safe to expose to the browser (same trust level as any
# Supabase anon key), unlike SUPABASE_SERVICE_ROLE_KEY.
VITE_VAERKSTED_SUPABASE_URL=
VITE_VAERKSTED_SUPABASE_ANON_KEY=
# vaerksted-auth's own public base URL, reachable directly from the browser
# (its POST /identities) — usually the same URL as VAERKSTED_AUTH_BASE_URL
# above, just under the VITE_ prefix so Vite exposes it to client code.
VITE_VAERKSTED_AUTH_BASE_URL=

# vaerksted-sync (apps/vaerksted-sync) — standalone sync relay for Skjald
# device-to-device meeting sync. See docs/design/vaerksted-auth-and-sync.md
# §9 for the full protocol. Own service, own Postgres schema — NOT the same
# DATABASE_URL/postgres container Maskin itself uses, and NOT the same
# logical schema as vaerksted-auth (own migration folder, own tables).
#
# Connection string for vaerksted-sync's own Postgres schema — in production
# this reuses the SAME Supabase-hosted Postgres project vaerksted-auth uses
# (design doc §10: "cheap to do now, expensive to retrofit" applies to
# schema separation, not a third database), under a distinct logical schema.
VAERKSTED_SYNC_DATABASE_URL=
# Reused, not duplicated: vaerksted-sync verifies device certs locally
# against the SAME Ed25519 public signing key vaerksted-auth issues certs
# with (see VAERKSTED_AUTH_SIGNING_PUBLIC_KEY above) — it never calls
# vaerksted-auth over the network per request (design doc §9). Set this to
# the identical value as VAERKSTED_AUTH_SIGNING_PUBLIC_KEY above.
