DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maskin
# Optional: overrides DATABASE_URL
# POSTGRES_URL=
# Optional: direct (non-pooled) connection for PG LISTEN/NOTIFY when using a connection pooler
# DATABASE_URL_DIRECT=

# Integration secrets encryption key (32-byte hex, 64 chars).
# Auto-generated by `pnpm dev` / `pnpm dev:win` if missing. Required to encrypt stored OAuth tokens.
INTEGRATION_ENCRYPTION_KEY=

# GitHub Integration
GITHUB_APP_ID
GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET
GITHUB_APP_WEBHOOK_SECRET
GITHUB_APP_PRIVATE_KEY
GITHUB_APP_SLUG

# Slack Integration
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Linear Integration
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=

# Maskin-funded OpenRouter account. This single key underwrites three routes:
#   1) the per-actor system fallback (workspaces with no key configured),
#   2) Maskin LLM subscriptions (settings.billing.plan ∈ starter/pro), and
#   3) the trial bucket (settings.billing.plan = trial).
# Recommended model: `deepseek/deepseek-v4-flash` (1,05M ctx, agentic-tuned,
# Input: $0,14/M tokens, Output: $0,28/M tokens). Leave the key blank to
# disable the fallback, the paid-plan route, and the trial route.
MASKIN_FALLBACK_OPENROUTER_KEY=
MASKIN_FALLBACK_BASE_URL=https://openrouter.ai/api
MASKIN_FALLBACK_MODEL=deepseek/deepseek-v4-flash
MASKIN_FALLBACK_SMALL_MODEL=deepseek/deepseek-v4-flash
# Per-actor daily input+output token cap. ~500k ≈ $0.20/user/day worst case.
MASKIN_FALLBACK_DAILY_TOKEN_LIMIT=550000
# Default trial-bucket cap for `billing.plan = trial` workspaces that haven't
# had a Stripe-backed `hard_cap_tokens` written. 100k ≈ ~50 messages at ~2k
# tokens each. Starter/pro workspaces read `hard_cap_tokens` from billing.
MASKIN_TRIAL_HARD_CAP_TOKENS=100000

# Gmail Integration
# OAuth2 Client ID + Secret from Google Cloud Console (project: sindre-430307)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Pub/Sub topic that receives Gmail push notifications.
# Format: projects/<project-id>/topics/<topic-name>
GMAIL_PUBSUB_TOPIC=
# Audience claim verified on incoming Pub/Sub push JWTs.
# Set this to the push endpoint URL configured on the subscription
# (e.g. https://<your-host>/api/webhooks/gmail).
GMAIL_PUBSUB_AUDIENCE=
# Service account email configured on the Pub/Sub push subscription.
# Pinning this prevents arbitrary Google service accounts from forging webhooks
# by minting OIDC tokens with the matching audience.
GMAIL_PUBSUB_SERVICE_ACCOUNT=
