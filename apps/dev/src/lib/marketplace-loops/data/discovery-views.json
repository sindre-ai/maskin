{
	"6f2c1a40-3d5e-4b8a-9c71-0a1e5d7b2c01": {
		"id": "6f2c1a40-3d5e-4b8a-9c71-0a1e5d7b2c01",
		"name": "Radar",
		"position": 0,
		"html": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Radar</title>\n<style>\n:root{--bg:#fff;--fg:#1a1a1a;--mut:#666;--card:#f5f5f3;--line:#e2e2de}\n@media (prefers-color-scheme:dark){:root{--bg:#161616;--fg:#ececec;--mut:#a0a0a0;--card:#222;--line:#363636}}\n*{box-sizing:border-box}\nbody{margin:0;padding:20px;background:var(--bg);color:var(--fg);font:15px/1.5 ui-sans-serif,system-ui,-apple-system,\"Segoe UI\",Roboto,Arial,sans-serif;max-width:760px}\nh1{font-size:20px;margin:0 0 4px}\n.lede{font-size:16px;margin:6px 0 0}\n.empty{margin-top:18px;background:var(--card);border:1px solid var(--line);border-radius:10px;padding:14px}\n.mut{color:var(--mut);font-size:13px}\n</style></head><body>\n<h1>Radar</h1>\n<p class=\"lede\">New understanding to pay attention to. Changes in what the loop understands, not data that arrived.</p>\n<div class=\"empty\"><strong>Nothing here yet.</strong>\n<p class=\"mut\">This page is written by the loop's agents as evidence comes in. Ask the loop to fill it in, or edit this page to change what the tab shows.</p></div>\n</body></html>\n"
	},
	"6f2c1a40-3d5e-4b8a-9c71-0a1e5d7b2c02": {
		"id": "6f2c1a40-3d5e-4b8a-9c71-0a1e5d7b2c02",
		"name": "Learning",
		"position": 1,
		"html": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Learning</title>\n<style>\n:root{--bg:#fff;--fg:#1a1a1a;--mut:#666;--card:#f5f5f3;--line:#e2e2de}\n@media (prefers-color-scheme:dark){:root{--bg:#161616;--fg:#ececec;--mut:#a0a0a0;--card:#222;--line:#363636}}\n*{box-sizing:border-box}\nbody{margin:0;padding:20px;background:var(--bg);color:var(--fg);font:15px/1.5 ui-sans-serif,system-ui,-apple-system,\"Segoe UI\",Roboto,Arial,sans-serif;max-width:760px}\nh1{font-size:20px;margin:0 0 4px}\n.lede{font-size:16px;margin:6px 0 0}\n.empty{margin-top:18px;background:var(--card);border:1px solid var(--line);border-radius:10px;padding:14px}\n.mut{color:var(--mut);font-size:13px}\n</style></head><body>\n<h1>Learning</h1>\n<p class=\"lede\">What is known, what is believed, what is not known, and when more will be learned.</p>\n<div class=\"empty\"><strong>Nothing here yet.</strong>\n<p class=\"mut\">This page is written by the loop's agents as evidence comes in. Ask the loop to fill it in, or edit this page to change what the tab shows.</p></div>\n</body></html>\n"
	},
	"6f2c1a40-3d5e-4b8a-9c71-0a1e5d7b2c03": {
		"id": "6f2c1a40-3d5e-4b8a-9c71-0a1e5d7b2c03",
		"name": "Briefing",
		"position": 2,
		"html": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Briefing</title>\n<style>\n:root{--bg:#fff;--fg:#1a1a1a;--mut:#666;--card:#f5f5f3;--line:#e2e2de}\n@media (prefers-color-scheme:dark){:root{--bg:#161616;--fg:#ececec;--mut:#a0a0a0;--card:#222;--line:#363636}}\n*{box-sizing:border-box}\nbody{margin:0;padding:20px;background:var(--bg);color:var(--fg);font:15px/1.5 ui-sans-serif,system-ui,-apple-system,\"Segoe UI\",Roboto,Arial,sans-serif;max-width:760px}\nh1{font-size:20px;margin:0 0 4px}\n.lede{font-size:16px;margin:6px 0 0}\n.empty{margin-top:18px;background:var(--card);border:1px solid var(--line);border-radius:10px;padding:14px}\n.mut{color:var(--mut);font-size:13px}\n</style></head><body>\n<h1>Briefing</h1>\n<p class=\"lede\">The loop&#x27;s briefing: what changed, what needs a decision, and what can wait.</p>\n<div class=\"empty\"><strong>Nothing here yet.</strong>\n<p class=\"mut\">This page is written by the loop's agents as evidence comes in. Ask the loop to fill it in, or edit this page to change what the tab shows.</p></div>\n</body></html>\n"
	},
	"6f2c1a40-3d5e-4b8a-9c71-0a1e5d7b2c04": {
		"id": "6f2c1a40-3d5e-4b8a-9c71-0a1e5d7b2c04",
		"name": "Opportunities",
		"position": 3,
		"html": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Opportunities</title>\n<style>\n:root{--bg:#fff;--fg:#1a1a1a;--mut:#666;--card:#f5f5f3;--line:#e2e2de}\n@media (prefers-color-scheme:dark){:root{--bg:#161616;--fg:#ececec;--mut:#a0a0a0;--card:#222;--line:#363636}}\n*{box-sizing:border-box}\nbody{margin:0;padding:20px;background:var(--bg);color:var(--fg);font:15px/1.5 ui-sans-serif,system-ui,-apple-system,\"Segoe UI\",Roboto,Arial,sans-serif;max-width:760px}\nh1{font-size:20px;margin:0 0 4px}\n.lede{font-size:16px;margin:6px 0 0}\n.empty{margin-top:18px;background:var(--card);border:1px solid var(--line);border-radius:10px;padding:14px}\n.mut{color:var(--mut);font-size:13px}\n</style></head><body>\n<h1>Opportunities</h1>\n<p class=\"lede\">Where there is a chance to win, what it would take, and which bets carry it.</p>\n<div class=\"empty\"><strong>Nothing here yet.</strong>\n<p class=\"mut\">This page is written by the loop's agents as evidence comes in. Ask the loop to fill it in, or edit this page to change what the tab shows.</p></div>\n</body></html>\n"
	},
	"6f2c1a40-3d5e-4b8a-9c71-0a1e5d7b2c05": {
		"id": "6f2c1a40-3d5e-4b8a-9c71-0a1e5d7b2c05",
		"name": "Pipeline",
		"position": 4,
		"html": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Pipeline</title>\n<style>\n:root{--bg:#fff;--fg:#1a1a1a;--mut:#666;--card:#f5f5f3;--line:#e2e2de;--a:#3b6fd4;--b:#b4531a;--bad:#b3261e;--open:#fff8ec;--openline:#e8c98f;--link:#2f5fbd}\n@media (prefers-color-scheme:dark){:root{--bg:#161616;--fg:#ececec;--mut:#a0a0a0;--card:#222;--line:#363636;--a:#5b8be0;--b:#d0773a;--bad:#f0877f;--open:#2a2418;--openline:#6b5524;--link:#8fb2f2}}\n*{box-sizing:border-box}\nbody{margin:0;padding:20px;background:var(--bg);color:var(--fg);font:15px/1.5 ui-sans-serif,system-ui,-apple-system,\"Segoe UI\",Roboto,Arial,sans-serif;max-width:1100px}\nh1{font-size:20px;margin:0 0 4px}h2{font-size:15px;margin:26px 0 6px}h3{font-size:13px;margin:0 0 6px}\n.mut{color:var(--mut);font-size:13px}.err{color:var(--bad);font-size:13px}\na{color:var(--link)}a:focus-visible,summary:focus-visible{outline:2px solid var(--a);outline-offset:2px}\n.lede{font-size:16px;margin:6px 0 0}\n.cover{margin-top:14px;background:var(--card);border:1px solid var(--line);border-radius:10px;padding:12px}\n.cbar{display:flex;height:12px;border-radius:6px;overflow:hidden;background:var(--line);margin:8px 0 6px}\n.cbar i{display:block;height:100%;background:var(--a)}\n.band{margin-top:14px;font-size:12px;color:var(--mut);display:flex;gap:6px;align-items:center}\n.band b{font-weight:600;color:var(--fg)}\n.flow{display:flex;gap:0;align-items:stretch;margin-top:6px;flex-wrap:wrap}\n.grp{display:flex;align-content:flex-start;flex:1 1 auto;gap:0;border-radius:10px;padding:8px;border:1px solid var(--line)}\n.grp.open{background:var(--open);border-color:var(--openline);flex:3 1 330px}.grp.closed{background:var(--card);flex:3 1 330px}\n.grp>.lab{display:none}\n.stage{flex:1 1 0;min-width:84px;padding:6px 10px;position:relative}\n.stage+.stage{border-left:1px dashed var(--line)}\n.stage .n{font-size:26px;line-height:1.15;font-weight:600}\n.stage .nm{font-size:13px;font-weight:600}\n.stage .sub{font-size:12px;color:var(--mut)}\n.gl{font-size:12px;color:var(--mut);margin:0 0 4px}\n.cols2{display:grid;grid-template-columns:3fr 4fr;gap:14px}\n.arrow{align-self:center;padding:0 6px;color:var(--mut);font-size:18px}\ntable{border-collapse:collapse;width:100%;font-size:13px}\nth,td{text-align:right;padding:6px 8px;border-bottom:1px solid var(--line)}th:first-child,td:first-child{text-align:left}\nth{font-weight:600;color:var(--mut);font-size:12px;vertical-align:bottom}\ntd small{color:var(--mut)}\n.lists{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:10px;margin-top:10px}\ndetails{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:8px 12px}\nsummary{cursor:pointer;font-weight:600;font-size:13px}\nol{margin:8px 0 0;padding:0;list-style:none;font-size:13px}\nli{display:grid;grid-template-columns:1fr auto;gap:8px;padding:4px 0;border-top:1px solid var(--line)}\nli a{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0}\nli span{color:var(--mut);font-size:12px;white-space:nowrap}\n.legend{display:flex;gap:14px;font-size:12px;color:var(--mut);margin:6px 0}\n.legend i{display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:5px;vertical-align:-1px}\nsvg text{fill:var(--mut);font-size:10px}\n.na{color:var(--mut)}\n@media (max-width:700px){\n body{padding:14px}\n .flow{flex-direction:column;gap:8px}\n .grp,.grp.open,.grp.closed{flex:0 0 auto;flex-wrap:wrap}.stage{flex:1 1 40%}.stage+.stage{border-left:0}\n .grp>.lab{display:block;flex:0 0 100%;font-size:12px;font-weight:600;padding:0 10px 4px}\n .cols2{grid-template-columns:1fr}.band{display:none}\n th,td{padding:6px 4px}\n}\n</style></head><body>\n<script id=\"maskin-sources\" type=\"application/json\">{\n\"insScope\":{\"scope\":\"__MASKIN_LOOP_ID__\",\"type\":\"insight\",\"group_by\":\"status\"},\n\"insAll\":{\"type\":\"insight\",\"group_by\":\"status\"},\n\"betScope\":{\"scope\":\"__MASKIN_LOOP_ID__\",\"type\":\"bet\",\"group_by\":\"status\"},\n\"betAll\":{\"type\":\"bet\",\"group_by\":\"status\"},\n\"oldScope\":{\"scope\":\"__MASKIN_LOOP_ID__\",\"type\":\"insight\",\"group_by\":\"status\",\"filters\":{\"status\":[\"new\",\"processing\",\"scored\"],\"created_before\":\"now-8d\"}},\n\"oldAll\":{\"type\":\"insight\",\"group_by\":\"status\",\"filters\":{\"status\":[\"new\",\"processing\",\"scored\"],\"created_before\":\"now-8d\"}},\n\"oldestScope\":{\"scope\":\"__MASKIN_LOOP_ID__\",\"type\":\"insight\",\"group_by\":\"status\",\"filters\":{\"status\":[\"new\",\"processing\",\"scored\"],\"created_before\":\"now-30d\"}},\n\"oldestAll\":{\"type\":\"insight\",\"group_by\":\"status\",\"filters\":{\"status\":[\"new\",\"processing\",\"scored\"],\"created_before\":\"now-30d\"}},\n\"inDay\":{\"scope\":\"__MASKIN_LOOP_ID__\",\"type\":\"insight\",\"group_by\":\"created_at.day\",\"filters\":{\"created_after\":\"today-13d\"}},\n\"closedDay\":{\"scope\":\"__MASKIN_LOOP_ID__\",\"type\":\"insight\",\"group_by\":\"updated_at.day\",\"filters\":{\"status\":[\"clustered\",\"parked\",\"discarded\"],\"updated_after\":\"today-13d\"}}\n}</script>\n\n<h1>Pipeline: where is each item, and what is stuck?</h1>\n<p class=\"lede\" id=\"lede\">Loading…</p>\n<div id=\"err\" class=\"err\"></div>\n\n<div class=\"cover\" id=\"cover\">\n <h3>How much of the workspace does this flow see?</h3>\n <div id=\"coverTxt\" class=\"na\">Loading…</div>\n <div class=\"cbar\" id=\"cbar\" aria-hidden=\"true\"></div>\n <div class=\"mut\">Only items linked to this flow are counted in the big numbers below. The rest are shown as \"not linked to this flow\".</div>\n</div>\n\n<h2>Insights: from new to a home</h2>\n<p class=\"gl\">An insight is closed when it has a home: attached to a bet, handed to an owner, or parked with a named wake condition.</p>\n<div class=\"flow\" id=\"insFlow\"></div>\n\n<h2>Bets: what the flow produces</h2>\n<p class=\"gl\">Bets are not counted as open or closed here. Big number is in this flow, small is the whole workspace.</p>\n<div class=\"flow\" id=\"betFlow\"></div>\n\n<h2>What is stuck?</h2>\n<p class=\"gl\">Open insights by age. \"Past the median\" means older than 8 days.</p>\n<div id=\"ageBox\"><span class=\"na\">Loading…</span></div>\n\n<h2>How many come in, and how many close?</h2>\n<p class=\"gl\">Last 14 days, this flow only. Closed is counted by the day a closed insight was last changed, so it also includes edits to old closed items.</p>\n<div class=\"legend\"><span><i style=\"background:var(--a)\"></i>New insights</span><span><i style=\"background:var(--b)\"></i>Closed or changed while closed</span></div>\n<div id=\"chart\"><span class=\"na\">Loading…</span></div>\n\n<script>\nconst $=id=>document.getElementById(id);\nconst fmt=n=>(typeof n===\"number\"?n.toLocaleString(\"en-US\"):\"n/a\");\nconst INS=[[\"new\",\"New\",\"open\"],[\"processing\",\"Processing\",\"open\"],[\"scored\",\"Scored\",\"open\"],[\"clustered\",\"Clustered\",\"closed\"],[\"parked\",\"Parked\",\"closed\"],[\"discarded\",\"Discarded\",\"closed\"]];\nconst BET=[[\"opportunity\",\"Opportunity\"],[\"define\",\"Define\"],[\"active\",\"Active\"],[\"live\",\"Live\"],[\"paused\",\"Paused\"],[\"succeeded\",\"Succeeded\"],[\"archived\",\"Archived\"]];\nconst OPEN=[\"new\",\"processing\",\"scored\"];\nconst errs={};\nfunction el(t,c,x){const e=document.createElement(t);if(c)e.className=c;if(x!==undefined)e.textContent=x;return e}\nfunction by(r){const m={};(r.groups||[]).forEach(g=>m[g.key]=g.count);return m}\nfunction note(name,e){errs[name]=(e&&e.message)||String(e);$(\"err\").textContent=\"Could not load: \"+Object.keys(errs).map(k=>k+\" (\"+errs[k]+\")\").join(\"; \")}\nconst ok=typeof maskin!==\"undefined\"&&maskin&&typeof maskin.query===\"function\";\nfunction q(name){return ok?maskin.query(name):Promise.reject(new Error(\"Live numbers are not available outside Maskin.\"))}\n\nfunction stageCard(label,scoped,all,key,mode){\n  const s=el(\"div\",\"stage\");\n  s.append(el(\"div\",\"nm\",label));\n  const n=el(\"div\",\"n\",scoped==null?\"n/a\":fmt(scoped));\n  if(scoped==null)n.className=\"n na\";\n  s.append(n);\n  if(mode===\"ins\"){\n    s.append(el(\"div\",\"sub\",all==null||scoped==null?\"workspace: n/a\":fmt(all-scoped)+\" not linked to this flow\"));\n  }else{\n    s.append(el(\"div\",\"sub\",all==null?\"workspace: n/a\":\"of \"+fmt(all)+\" in workspace\"));\n  }\n  return s;\n}\nfunction renderFlow(box,defs,sc,al,mode){\n  box.innerHTML=\"\";\n  if(mode===\"ins\"){\n    const o=el(\"div\",\"grp open\"),c=el(\"div\",\"grp closed\");\n    o.append(el(\"div\",\"lab\",\"Open: waiting for a home\"));c.append(el(\"div\",\"lab\",\"Closed: has a home\"));\n    defs.forEach(d=>(d[2]===\"open\"?o:c).append(stageCard(d[1],sc?(sc[d[0]]||0):null,al?(al[d[0]]||0):null,d[0],\"ins\")));\n    box.append(o,el(\"div\",\"arrow\",\"→\"),c);\n    box.children[1].style.display=\"none\";\n  }else{\n    const g=el(\"div\",\"grp closed\");g.style.flex=\"1 1 100%\";g.style.flexWrap=\"wrap\";\n    defs.forEach(d=>g.append(stageCard(d[1],sc?(sc[d[0]]||0):null,al?(al[d[0]]||0):null,d[0],\"bet\")));\n    box.append(g);\n  }\n}\nlet insS=null,insA=null;\nfunction drawIns(){renderFlow($(\"insFlow\"),INS,insS,insA,\"ins\");drawCover();drawLede();drawAge()}\nfunction sum(m,keys){return m?keys.reduce((a,k)=>a+(m[k]||0),0):null}\nfunction drawCover(){\n  const t=$(\"coverTxt\"),b=$(\"cbar\");b.innerHTML=\"\";\n  if(!insS||!insA){t.className=\"err\";t.textContent=\"Could not compare: \"+(errs.insScope||errs.insAll||\"no data\");return}\n  const s=sum(insS,Object.keys(insS)),a=sum(insA,Object.keys(insA));\n  t.className=\"\";\n  if(!a){t.className=\"na\";t.textContent=\"No insights in the workspace yet.\";return}\n  t.textContent=\"\";\n  const b1=el(\"b\",null,fmt(s)+\" of \"+fmt(a));t.append(b1,\" insights are linked to this flow. \",el(\"b\",null,fmt(a-s)),' are not linked to this flow ('+Math.round(100*(a-s)/a)+\"%).\");\n  const i=el(\"i\");i.style.width=(100*s/a)+\"%\";b.append(i);\n  const low=INS.filter(d=>insA[d[0]]>0).map(d=>({L:d[1],p:(insS[d[0]]||0)/insA[d[0]],s:insS[d[0]]||0,a:insA[d[0]]})).sort((x,y)=>x.p-y.p).slice(0,2);\n  t.append(\" Least linked: \"+low.map(x=>x.L+\" \"+fmt(x.s)+\" of \"+fmt(x.a)+\" (\"+Math.round(100*x.p)+\"%)\").join(\", \")+\".\");\n}\nfunction drawLede(){\n  const L=$(\"lede\");\n  if(!insS){L.className=\"lede err\";L.textContent=\"Could not load the insight counts.\";return}\n  const open=sum(insS,OPEN);\n  let txt=fmt(open)+\" insights in this flow are still open (\"+fmt(insS.new||0)+\" new, \"+fmt(insS.processing||0)+\" processing, \"+fmt(insS.scored||0)+\" scored).\";\n  if(old.s){const o=sum(old.s,OPEN);txt+=\" \"+fmt(o)+\" of them are older than the 8-day median.\"}\n  L.className=\"lede\";L.textContent=txt;\n}\nconst old={s:null,a:null,s30:null,a30:null};\nfunction drawAge(){\n  const box=$(\"ageBox\");\n  const t=el(\"table\");\n  t.innerHTML=\"<thead><tr><th>Open stage</th><th>In this flow</th><th>Past the median (8 days)</th><th>Past 30 days</th><th>Workspace: all / past 8d / past 30d</th></tr></thead>\";\n  const tb=el(\"tbody\");\n  OPEN.forEach(k=>{\n    const L=INS.find(d=>d[0]===k)[1],tr=el(\"tr\");\n    const cell=(m,key)=>m?fmt(m[key]||0):\"n/a\";\n    tr.append(el(\"td\",null,L),el(\"td\",null,cell(insS,k)),el(\"td\",null,cell(old.s,k)),el(\"td\",null,cell(old.s30,k)));\n    const w=el(\"td\");w.append(el(\"small\",null,cell(insA,k)+\" / \"+cell(old.a,k)+\" / \"+cell(old.a30,k)));tr.append(w);\n    tb.append(tr);\n  });\n  t.append(tb);box.innerHTML=\"\";box.append(t);\n  if(errs.oldScope||errs.oldestScope||errs.oldAll||errs.oldestAll){box.append(el(\"div\",\"err\",\"Some age numbers did not load; they show n/a.\"))}\n}\n\nfunction drawChart(inD,clD){\n  const box=$(\"chart\");box.innerHTML=\"\";\n  const days=[];const now=new Date();\n  for(let i=13;i>=0;i--){const d=new Date(Date.UTC(now.getUTCFullYear(),now.getUTCMonth(),now.getUTCDate()-i));days.push(d.toISOString().slice(0,10))}\n  const A=inD?by(inD):null,B=clD?by(clD):null;\n  if(!A&&!B){box.append(el(\"div\",\"err\",\"Could not load the daily counts.\"));return}\n  const sa=A?days.reduce((s,d)=>s+(A[d]||0),0):0,sb=B?days.reduce((s,d)=>s+(B[d]||0),0):0;\n  if(!sa&&!sb&&A&&B){box.append(el(\"div\",\"na\",\"No new or closed insights in the last 14 days.\"));return}\n  const max=Math.max(1,...days.map(d=>Math.max(A?A[d]||0:0,B?B[d]||0:0)));\n  const W=Math.max(320,Math.min(700,Math.round(box.clientWidth||700))),H=190,L=30,Bm=26,T=8,pw=(W-L)/14,step=W<500?3:2;\n  const ns=\"http://www.w3.org/2000/svg\";\n  const s=document.createElementNS(ns,\"svg\");s.setAttribute(\"viewBox\",\"0 0 \"+W+\" \"+H);s.setAttribute(\"role\",\"img\");s.style.width=\"100%\";s.style.height=\"auto\";s.style.display=\"block\";\n  s.setAttribute(\"aria-label\",\"Bars per day for the last 14 days: new insights \"+sa+\" and closed or changed while closed \"+sb);\n  function mk(t,a,tx){const e=document.createElementNS(ns,t);for(const k in a)e.setAttribute(k,a[k]);if(tx!=null)e.textContent=tx;return e}\n  const ch=H-Bm-T;\n  [0,0.5,1].forEach(f=>{const y=T+ch*(1-f);s.append(mk(\"line\",{x1:L,x2:W,y1:y,y2:y,stroke:\"var(--line)\",\"stroke-width\":1}),mk(\"text\",{x:L-4,y:y+3,\"text-anchor\":\"end\"},Math.round(max*f)))});\n  days.forEach((d,i)=>{\n    const x0=L+i*pw+pw*0.12,bw=pw*0.34;\n    const g=mk(\"g\",{});\n    const ta=A?(A[d]||0):null,tb=B?(B[d]||0):null;\n    g.append(mk(\"title\",{},d+\": \"+(ta==null?\"new n/a\":ta+\" new\")+\", \"+(tb==null?\"closed n/a\":tb+\" closed\")));\n    if(ta!=null){const h=ch*ta/max;g.append(mk(\"rect\",{x:x0,y:T+ch-h,width:bw,height:Math.max(h,ta?1:0),rx:2,fill:\"var(--a)\"}))}\n    if(tb!=null){const h=ch*tb/max;g.append(mk(\"rect\",{x:x0+bw+2,y:T+ch-h,width:bw,height:Math.max(h,tb?1:0),rx:2,fill:\"var(--b)\"}))}\n    g.append(mk(\"rect\",{x:L+i*pw,y:T,width:pw,height:ch+Bm-6,fill:\"transparent\"}));\n    s.append(g);\n    if(i%step===(13%step)||days.length<8)s.append(mk(\"text\",{x:L+i*pw+pw/2,y:H-8,\"text-anchor\":(L+i*pw+pw/2>W-16)?\"end\":\"middle\"},d.slice(8)+\"/\"+d.slice(5,7)));\n  });\n  box.append(s);\n  const tot=el(\"p\",\"mut\",\"Last 14 days: \"+(A?fmt(sa):\"n/a\")+\" new, \"+(B?fmt(sb):\"n/a\")+\" closed or changed while closed. Hover a day for its numbers.\");\n  box.append(tot);\n  if(!A||!B)box.append(el(\"div\",\"err\",\"One of the two series did not load and is left out.\"));\n}\n\nrenderFlow($(\"insFlow\"),INS,null,null,\"ins\");renderFlow($(\"betFlow\"),BET,null,null,\"bet\");\nlet betS=null,betA=null;\nfunction drawBets(){renderFlow($(\"betFlow\"),BET,betS,betA,\"bet\")}\nlet inD=null,clD=null,chartSeen=0;\nfunction chartMaybe(){if(++chartSeen===2)drawChart(inD,clD)}\nif(!ok){$(\"err\").textContent=\"Live numbers are not available outside Maskin.\";[\"lede\",\"coverTxt\"].forEach(i=>$(i).textContent=\"n/a\");$(\"ageBox\").textContent=\"n/a\";$(\"chart\").textContent=\"n/a\"}\nq(\"insScope\").then(r=>{insS=by(r);drawIns()}).catch(e=>{note(\"insScope\",e);drawIns()});\nq(\"insAll\").then(r=>{insA=by(r);drawIns()}).catch(e=>{note(\"insAll\",e);drawIns()});\nq(\"betScope\").then(r=>{betS=by(r);drawBets()}).catch(e=>{note(\"betScope\",e);drawBets()});\nq(\"betAll\").then(r=>{betA=by(r);drawBets()}).catch(e=>{note(\"betAll\",e);drawBets()});\nq(\"oldScope\").then(r=>{old.s=by(r);drawAge();drawLede()}).catch(e=>{note(\"oldScope\",e);drawAge()});\nq(\"oldAll\").then(r=>{old.a=by(r);drawAge()}).catch(e=>{note(\"oldAll\",e);drawAge()});\nq(\"oldestScope\").then(r=>{old.s30=by(r);drawAge()}).catch(e=>{note(\"oldestScope\",e);drawAge()});\nq(\"oldestAll\").then(r=>{old.a30=by(r);drawAge()}).catch(e=>{note(\"oldestAll\",e);drawAge()});\nq(\"inDay\").then(r=>{inD=r;chartMaybe()}).catch(e=>{note(\"inDay\",e);inD=null;chartMaybe()});\nq(\"closedDay\").then(r=>{clD=r;chartMaybe()}).catch(e=>{note(\"closedDay\",e);clD=null;chartMaybe()});\n</script>\n</body></html>\n"
