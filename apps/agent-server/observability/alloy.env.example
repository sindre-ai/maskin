# Grafana Alloy log + metrics shipping — deployment-specific settings.
#
# These belong to the ALLOY process, not to agent-server. Copy to
# /etc/default/alloy on the host; do NOT add them to apps/agent-server/.env or
# to turbo.json globalPassThroughEnv — no Node process reads them.
#
# See ./README.md for the full setup, and ./alloy.alloy for how each value is
# consumed.

# --- Logs destination (required) --------------------------------------------

# Loki push endpoint.
#   Grafana Cloud: https://logs-prod-<NNN>.grafana.net/loki/api/v1/push
#     (Grafana Cloud → your stack → Loki → "Send Logs" shows the exact host;
#      the number differs per region, so there is no correct default here.)
#   Self-hosted:   http://loki.internal:3100/loki/api/v1/push
LOKI_URL=

# Grafana Cloud: username is the numeric stack/user id shown next to the URL
# above; password is an access policy token scoped to logs:write.
# Self-hosted without auth: leave both blank AND comment out the basic_auth
# block in alloy.alloy — blank credentials still send an Authorization header.
LOKI_USERNAME=
LOKI_PASSWORD=

# Multi-tenant Loki only — sets X-Scope-OrgID. Leave blank for Grafana Cloud
# or a single-tenant deployment.
LOKI_TENANT_ID=

# --- Metrics destination (required) -----------------------------------------
#
# These are NOT the Loki values. Grafana Cloud runs logs and metrics on
# separate clusters with separate numeric usernames; reusing LOKI_USERNAME here
# produces a 401 that looks exactly like a bad token. Copy each value from the
# metrics page, not the logs page.

# Prometheus remote-write endpoint.
#   Grafana Cloud: https://prometheus-prod-<NN>-prod-<REGION>.grafana.net/api/prom/push
#     (Grafana Cloud → your stack → Prometheus → "Send Metrics". Both the
#      cluster number and the region string vary per stack, so — as with
#      LOKI_URL — there is no correct default to put here.)
#   Self-hosted:   http://prometheus.internal:9090/api/v1/write
PROM_URL=

# Grafana Cloud: username is the numeric PROMETHEUS instance id shown on that
# same "Send Metrics" page. It is a DIFFERENT number from the Loki stack id in
# LOKI_USERNAME above — check them against each other before first push.
#
# The password may be the same access policy token as LOKI_PASSWORD, provided
# the policy is scoped to both logs:write and metrics:write. One token for both
# is fine; one username for both is not.
#
# Self-hosted without auth: leave both blank AND comment out the basic_auth
# block in the prometheus.remote_write component in alloy.alloy.
PROM_USERNAME=
PROM_PASSWORD=

# --- Labels (optional, defaults shown) --------------------------------------

# The `job` label on every shipped line. Change it if you run more than one
# agent-server fleet against the same Loki and want to query them apart.
LOKI_JOB_LABEL=maskin-agent-server

# The `job` label on host metrics. Deliberately NOT the same as
# LOKI_JOB_LABEL: these series describe the host (kernel, disks, NICs), not the
# agent-server process. See the comment on prometheus.scrape in alloy.alloy.
#
# Keep this default unless you have a reason not to. Grafana Cloud's prebuilt
# Linux Server integration dashboards filter on exactly this value, so leaving
# it alone gets you the whole prebuilt node dashboard set — CPU, memory, disk,
# network — with no panel building. Change it and those dashboards render
# empty.
PROM_JOB_LABEL=integrations/node_exporter

# The `env` label. Applied to BOTH logs and metrics — keep it one value per
# deployment so the two line up. Useful once staging and production ship to one
# stack.
DEPLOY_ENV=production

# The `instance` label, applied to BOTH logs and metrics. This is the join key:
# it is what makes {instance="finland-1"} select the same host in LogQL and in
# PromQL, which is the entire reason a CPU spike can be pivoted to that host's
# logs for the same instant.
#
# Defaults to the machine's hostname, which is fine if hostnames are stable and
# meaningful. Set it explicitly if the hostname is a provider-assigned string
# you would not recognise in a dashboard, or if the box may be rebuilt under a
# new hostname — a changed value here silently splits every dashboard and
# saved query at the moment it changes.
AGENT_SERVER_INSTANCE=

# --- Source (optional, defaults shown) --------------------------------------

# Must match SyslogIdentifier in systemd/maskin-agent-server.service. Only
# change this if you also changed it there.
AGENT_SERVER_SYSLOG_ID=maskin-agent-server

# Persistent journal location. Only override on a host with a non-standard
# journald layout.
ALLOY_JOURNAL_PATH=/var/log/journal
