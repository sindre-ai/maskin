// Grafana Alloy — ship agent-server's structured logs to Loki, and this
// host's resource metrics to Prometheus.
//
// This is HOST configuration, not application configuration. agent-server
// itself has no vendor SDK and no knowledge of Loki: it writes one NDJSON
// object per line to stdout/stderr (see src/lib/logger.ts), systemd captures
// that into journald (StandardOutput=journal in
// systemd/maskin-agent-server.service), and this file is the only place the
// log backend is named. Swapping Loki for another destination means replacing
// the loki.write component below and nothing else.
//
// The metrics half is even more detached from the application: node_exporter
// reads /proc and /sys. Nothing in apps/agent-server/src/ is involved, and
// there is deliberately no /metrics endpoint on agent-server — application
// instrumentation (session gauges, dispatch latency) is separate, larger work.
//
// The two pipelines share the `env` and `instance` labels on purpose: that
// shared identity is what lets you pivot from a CPU spike in PromQL to this
// host's logs for the same instant in LogQL. See README.md → "Correlating
// metrics and logs".
//
// Install: /etc/alloy/config.alloy
// Settings: see alloy.env.example — every deployment-specific value is read
// from the environment so this file can be committed unmodified.
//
// Full setup instructions: ./README.md

// ---------------------------------------------------------------------------
// Source — journald, filtered to the agent-server unit
// ---------------------------------------------------------------------------

// Journal fields arrive prefixed with `__journal_` and are dropped unless
// explicitly promoted here.
loki.relabel "journal" {
	forward_to = []

	rule {
		source_labels = ["__journal__systemd_unit"]
		target_label  = "unit"
	}

	rule {
		source_labels = ["__journal_syslog_identifier"]
		target_label  = "service_name"
	}
}

loki.source.journal "agent_server" {
	// Alloy reads the persistent journal directly; it needs to run as root or
	// as a member of the systemd-journal group.
	path = coalesce(sys.env("ALLOY_JOURNAL_PATH"), "/var/log/journal")

	// Matches the SyslogIdentifier set by the systemd unit. Only this unit's
	// entries are read, so an unrelated chatty service can't inflate the bill.
	matches = "SYSLOG_IDENTIFIER=" + coalesce(sys.env("AGENT_SERVER_SYSLOG_ID"), "maskin-agent-server")

	labels = {
		job = coalesce(sys.env("LOKI_JOB_LABEL"), "maskin-agent-server"),
		env = coalesce(sys.env("DEPLOY_ENV"), "production"),

		// Identifies the box. The metrics pipeline below applies the SAME
		// value, so {instance="finland-1"} selects this host in both LogQL
		// and PromQL. Bounded by the number of hosts, so safe as a label.
		instance = coalesce(sys.env("AGENT_SERVER_INSTANCE"), constants.hostname),
	}

	relabel_rules = loki.relabel.journal.rules
	forward_to    = [loki.process.agent_server.receiver]
}

// ---------------------------------------------------------------------------
// Processing — parse the NDJSON, and split fields by cardinality
// ---------------------------------------------------------------------------

loki.process "agent_server" {
	forward_to = [loki.write.default.receiver]

	// Every logger call emits {level, time, msg, ...ctx}. Lines that aren't
	// JSON (e.g. the "[sentry] captureMessage failed" fallback writes) simply
	// extract nothing and pass through with the labels above — they are not
	// dropped.
	stage.json {
		expressions = {
			level      = "level",
			time       = "time",
			source     = "source",
			stream     = "stream",
			session_id = "sessionId",
		}
	}

	// Prefer the application's own timestamp over journald's ingest time, so
	// ordering survives a collector restart or an ingest backlog.
	stage.timestamp {
		source = "time"
		format = "RFC3339"
	}

	// LABELS — low cardinality ONLY.
	//
	// Loki creates one stream per unique label combination, and the index
	// grows with that count. `level` has four values; `source` has a handful
	// (currently only 'msb-exec' plus absent). Both are safe and both are
	// worth having as labels because they are the usual first filter.
	stage.labels {
		values = {
			level  = "",
			source = "",
		}
	}

	// STRUCTURED METADATA — unbounded values go here, never in labels.
	//
	// `sessionId` is one value per agent session, forever. As a label it would
	// produce an unbounded number of tiny streams: an index far larger than
	// the logs, slow queries, and on a usage-billed backend a cost that scales
	// with session count rather than log volume. Structured metadata (Loki
	// 3.0+) keeps it filterable at query time with no index cost.
	stage.structured_metadata {
		values = {
			session_id = "",
			stream     = "",
		}
	}
}

// ---------------------------------------------------------------------------
// Destination
// ---------------------------------------------------------------------------

loki.write "default" {
	endpoint {
		url = sys.env("LOKI_URL")

		// Multi-tenant Loki: sets X-Scope-OrgID. Leave unset for a
		// single-tenant or Grafana Cloud stack.
		tenant_id = sys.env("LOKI_TENANT_ID")

		// Grafana Cloud: username is the numeric stack id, password is an
		// access policy token with logs:write.
		//
		// Self-hosted Loki with no auth: comment this whole block out rather
		// than leaving the values blank — an empty basic_auth still sends an
		// Authorization header.
		basic_auth {
			username = sys.env("LOKI_USERNAME")
			password = sys.env("LOKI_PASSWORD")
		}
	}

	// Survive a brief Loki outage or restart without losing the window you'd
	// actually want to investigate.
	wal {
		enabled = true
	}
}

// ===========================================================================
// METRICS — host resources → Prometheus
// ===========================================================================
//
// The question this half exists to answer is "what is the CPU/memory/disk on
// the Finland box doing right now", without ssh. It is capacity monitoring,
// not incident-second-resolution telemetry, which is why the scrape interval
// is 60s rather than the usual 15s.

// ---------------------------------------------------------------------------
// Source — node_exporter, embedded in Alloy
// ---------------------------------------------------------------------------

prometheus.exporter.unix "host" {
	// COLLECTORS — an explicit list, not the default set.
	//
	// Grafana Cloud's free tier allows 10k active series. node_exporter's
	// defaults run 500–1000 series on a box like this, so one or two hosts
	// fit comfortably — but that headroom disappears fast if collectors get
	// enabled "for completeness". Everything here earns its place against
	// the capacity question above:
	//
	//   cpu        — utilisation, per core, per mode
	//   meminfo    — total/available/cached; the memory-pressure signal
	//   loadavg    — 1/5/15m; 3 series, the cheapest saturation indicator
	//   filesystem — free bytes per mount; answers "will the disk fill"
	//   diskstats  — IOPS and I/O time; microVM disk images live here
	//   netdev     — bytes/errors per interface
	//   uname      — one series, but it labels kernel version onto the host
	//
	// Deliberately NOT enabled:
	//
	//   textfile   — nothing writes .prom files on this box; enabling it is
	//                an open door to unbounded series from a future script.
	//   systemd    — per-unit series for every unit on the host. Useful in
	//                principle, but agent-server's health is already covered
	//                by its logs, and this is the single biggest cardinality
	//                jump available here.
	//   processes  — per-process-state series; msb spawns and reaps a process
	//                per session, so this tracks session churn as metric
	//                cardinality. Exactly the unbounded-label mistake the
	//                logs pipeline avoids with sessionId.
	//   interrupts, netstat, sockstat, vmstat, arp, netclass, hwmon, thermal,
	//   nfs*, rapl, schedstat, softnet, xfs, zfs, mdadm, infiniband, ipvs,
	//   bonding, btrfs, edac, entropy, fibrechannel, filefd, pressure,
	//   stat, time, timex, udp_queues — either irrelevant to a single-tenant
	//                KVM box, or hundreds of series answering questions we
	//                have never once asked.
	set_collectors = [
		"cpu",
		"meminfo",
		"loadavg",
		"filesystem",
		"diskstats",
		"netdev",
		"uname",
	]

	filesystem {
		// One series set per mount point. microsandbox creates and destroys
		// mounts per microVM, so without these exclusions filesystem series
		// would churn with session lifecycle — the metrics-side equivalent
		// of putting sessionId in a Loki label. Only real, persistent
		// filesystems are wanted here.
		mount_points_exclude = "^/(dev|proc|sys|run|var/lib/(docker|microsandbox|msb)/.+)($|/)"
		fs_types_exclude     = "^(autofs|binfmt_misc|bpf|cgroup2?|configfs|debugfs|devpts|devtmpfs|fusectl|hugetlbfs|iso9660|mqueue|nsfs|overlay|proc|procfs|pstore|ramfs|rpc_pipefs|securityfs|selinuxfs|squashfs|sysfs|tracefs)$"
	}
}

// ---------------------------------------------------------------------------
// Labels — must agree with the logs pipeline above
// ---------------------------------------------------------------------------

discovery.relabel "host" {
	targets = prometheus.exporter.unix.host.targets

	// prometheus.scrape would otherwise set `instance` to the scrape target's
	// address ("127.0.0.1:12345"), which is both meaningless and identical on
	// every host. Overriding it here with the same expression the journal
	// source uses is what makes the two pipelines joinable.
	rule {
		target_label = "instance"
		replacement  = coalesce(sys.env("AGENT_SERVER_INSTANCE"), constants.hostname)
	}

	rule {
		target_label = "env"
		replacement  = coalesce(sys.env("DEPLOY_ENV"), "production")
	}
}

prometheus.scrape "host" {
	targets    = discovery.relabel.host.output
	forward_to = [prometheus.remote_write.default.receiver]

	// `job` is intentionally NOT "maskin-agent-server" (the logs value).
	// These series describe the HOST — kernel, disks, NICs — not the
	// agent-server process; none of them would exist or change if the
	// service were stopped. Naming them after the application would imply
	// application instrumentation that does not exist here. `env` and
	// `instance` are the labels shared with logs, and they are the ones
	// correlation actually needs.
	job_name = coalesce(sys.env("PROM_JOB_LABEL"), "node")

	// Capacity monitoring. 60s over a month is ~43k samples per series;
	// at 15s it would be four times the ingest for a view nobody reads at
	// that resolution.
	scrape_interval = "60s"
	scrape_timeout  = "10s"
}

// ---------------------------------------------------------------------------
// Destination
// ---------------------------------------------------------------------------
//
// NOTE: this is NOT the Loki endpoint. In Grafana Cloud the Prometheus push
// URL, and especially the numeric username, differ from Loki's — see
// alloy.env.example. A single access policy token scoped logs:write +
// metrics:write serves both, but the usernames do not interchange, and
// crossing them yields a 401 that reads like a bad token.

prometheus.remote_write "default" {
	endpoint {
		url = sys.env("PROM_URL")

		// Grafana Cloud: username is the numeric PROMETHEUS instance id,
		// password is an access policy token with metrics:write.
		//
		// Self-hosted Prometheus with no auth: comment this whole block out
		// rather than leaving the values blank — an empty basic_auth still
		// sends an Authorization header.
		basic_auth {
			username = sys.env("PROM_USERNAME")
			password = sys.env("PROM_PASSWORD")
		}
	}

	// Mirrors the durability the loki.write component gets from its own WAL:
	// a brief remote outage or an Alloy restart must not lose the window you
	// would actually want to investigate. prometheus.remote_write keeps a WAL
	// unconditionally; these values just make the retention explicit rather
	// than implicit, and are long enough to ride out a short outage.
	wal {
		truncate_frequency = "2h"
		min_keepalive_time = "5m"
		max_keepalive_time = "8h"
	}
}
