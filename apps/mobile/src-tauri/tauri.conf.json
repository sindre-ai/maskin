{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Maskin",
	"version": "0.1.0",
	"identifier": "io.maskin.mobile",
	"build": {
		"beforeDevCommand": "pnpm --filter @maskin/web dev",
		"devUrl": "http://localhost:5173",
		"beforeBuildCommand": "pnpm --filter @maskin/web build",
		"frontendDist": "../../web/dist"
	},
	"app": {
		"windows": [
			{
				"title": "Maskin",
				"width": 800,
				"height": 600
			}
		],
		"security": {
			"csp": null
		}
	},
	"plugins": {
		"deep-link": {
			"mobile": [
				{
					"scheme": ["maskin"],
					"appLink": false
				}
			]
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
