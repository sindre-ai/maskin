{
	"name": "@maskin/vaerksted-auth",
	"version": "0.0.1",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "node build.mjs",
		"start": "node dist/index.js",
		"test": "vitest",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"type-check": "tsc --noEmit",
		"db:generate": "drizzle-kit generate --config=src/db/drizzle.config.ts",
		"db:migrate": "tsx src/db/migrate.ts"
	},
	"dependencies": {
		"@hono/node-server": "^1.19.13",
		"@maskin/vaerksted-crypto": "workspace:*",
		"@supabase/supabase-js": "^2.112.2",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.12.14",
		"jose": "^6.2.8",
		"postgres": "^3.4.9",
		"zod": "^3.24.0"
	},
	"devDependencies": {
		"@types/node": "^25.6.0",
		"drizzle-kit": "^0.31.10",
		"esbuild": "^0.28.0",
		"tsx": "^4.19.0",
		"typescript": "^5.7.0",
		"vitest": "^3.0.0"
	}
}
