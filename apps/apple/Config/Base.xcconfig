// Shared build settings for every Maskin target (attached as the project-level xcconfig in
// project.yml). Values here must NOT also be set in a target's `settings:` in project.yml —
// target settings outrank xcconfig values.

// iOS entitlements file. Default is the full set (Push + Associated Domains + keychain group).
// Point it at Apps/Maskin/Maskin-nopush.entitlements (in Local.xcconfig) to install on a device
// whose team has not enabled Push/Associated Domains on the App ID. See docs/device-install.md.
MASKIN_IOS_ENTITLEMENTS = Apps/Maskin/Maskin.entitlements

// Where the app opens web-only settings pages. Empty = the API's own origin (production).
MASKIN_WEB_BASE_URL =

// Product analytics. The PostHog project token of the project the web app reports to (the same value
// as VITE_POSTHOG_KEY). Empty = this build sends nothing and never shows the usage question; CI and
// local builds leave it empty. The TestFlight workflow passes it in. The host is written with $()
// because a bare // would start a comment.
MASKIN_POSTHOG_KEY =
MASKIN_POSTHOG_HOST = https:/$()/eu.i.posthog.com

// Optional, gitignored: DEVELOPMENT_TEAM and any overrides. CI has none and builds with
// CODE_SIGNING_ALLOWED=NO.
#include? "Local.xcconfig"
