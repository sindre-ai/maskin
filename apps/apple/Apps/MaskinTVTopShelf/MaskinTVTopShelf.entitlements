<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Read-only use of the TV app's signed-in session, as the iOS widgets do. Must be the FIRST
	     (and only) group so KeychainSecretStore resolves the same group the app writes to. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)io.maskin.app</string>
	</array>
</dict>
</plist>
