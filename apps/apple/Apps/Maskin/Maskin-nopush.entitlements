<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Device-test set for teams whose App ID lacks Push Notifications / Associated Domains:
	     keychain group only. Select with MASKIN_IOS_ENTITLEMENTS (Config/Local.xcconfig).
	     Push registration and universal links do not work in this configuration. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)io.maskin.app</string>
	</array>
</dict>
</plist>
