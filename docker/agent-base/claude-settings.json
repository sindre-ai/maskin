{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "AskUserQuestion",
				"hooks": [
					{
						"type": "command",
						"command": "/agent-hooks/ask-user-question.sh"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": ".*",
				"hooks": [
					{
						"type": "command",
						"command": "/agent-hooks/preview-ports-changed.sh"
					}
				]
			}
		]
	}
}
