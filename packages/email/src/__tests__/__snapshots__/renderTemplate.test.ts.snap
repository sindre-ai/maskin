exports[`renderTemplate > matches the html snapshot for account-verification 1`] = `"<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html dir="ltr" lang="en"><head><meta content="text/html; charset=UTF-8" http-equiv="Content-Type"/><meta name="x-apple-disable-message-reformatting"/></head><body style="background-color:#f6f7f8;margin:0;padding:0"><!--$--><!--html--><!--head--><div style="display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0" data-skip-in-text="true">Confirm your email to activate your Maskin account.<div> ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿</div></div><!--body--><table border="0" width="100%" cellPadding="0" cellSpacing="0" role="presentation" align="center"><tbody><tr><td style="background-color:#f6f7f8;font-family:Inter, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Helvetica, Arial, sans-serif;margin:0;padding:0"><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="max-width:560px;background-color:#ffffff;border-radius:8px;margin:32px auto;padding:32px"><tbody><tr style="width:100%"><td><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation"><tbody><tr><td><img alt="Maskin" height="32" src="https://maskin.io/email/maskin-logo.png" style="display:block;outline:none;border:none;text-decoration:none;margin:0 auto 24px" width="120"/></td></tr></tbody></table><h1 style="color:#111827;font-size:22px;font-weight:600;line-height:30px;margin:0 0 16px">Verify your email, <!-- -->Sindre</h1><p style="font-size:15px;line-height:24px;color:#374151;margin:0 0 16px;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Thanks for signing up for Maskin. Confirm this email is yours so you can start spinning up agents and running the shop.</p><p style="font-size:14px;line-height:24px;margin:24px 0;text-align:left;margin-top:24px;margin-right:0;margin-bottom:24px;margin-left:0"><a href="https://maskin.io/verify?token=abc123" style="line-height:100%;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:#111827;border-radius:6px;color:#ffffff;font-size:15px;font-weight:500;padding:12px 20px;padding-top:12px;padding-right:20px;padding-bottom:12px;padding-left:20px" target="_blank"><span><!--[if mso]><i style="mso-font-width:500%;mso-text-raise:18" hidden>&#8202;&#8202;</i><![endif]--></span><span style="max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:9px">Verify email</span><span><!--[if mso]><i style="mso-font-width:500%" hidden>&#8202;&#8202;&#8203;</i><![endif]--></span></a></p><p style="font-size:13px;line-height:20px;color:#6b7280;margin:0 0 24px;word-break:break-all;margin-top:0;margin-right:0;margin-bottom:24px;margin-left:0">Or paste this link into your browser:<!-- --> <a href="https://maskin.io/verify?token=abc123" style="color:#4b5563;text-decoration-line:none;text-decoration:underline" target="_blank">https://maskin.io/verify?token=abc123</a></p><p style="font-size:15px;line-height:24px;color:#374151;margin:0 0 16px;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">This link expires in 24 hours. If you didn&#x27;t create a Maskin account, you can safely ignore this email.</p><hr style="width:100%;border:none;border-top:1px solid #eaeaea;border-color:#e5e7eb;margin-top:32px"/><p style="font-size:12px;line-height:18px;color:#6b7280;margin-top:16px;text-align:center;margin-bottom:16px">Sent by Maskin — the shop where AI does the work and humans set direction.</p><p style="font-size:12px;line-height:18px;color:#6b7280;margin-top:16px;text-align:center;margin-bottom:16px">You&#x27;re getting this because you have a Maskin account.<!-- --> <a href="https://maskin.io/settings/notifications" style="color:#6b7280;text-decoration-line:none;text-decoration:underline" target="_blank">Manage email preferences</a>.</p></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>"`;

exports[`renderTemplate > matches the text snapshot for account-verification 1`] = `
"VERIFY YOUR EMAIL, SINDRE

Thanks for signing up for Maskin. Confirm this email is yours so you can start spinning up agents and running the shop.

Verify email https://maskin.io/verify?token=abc123

Or paste this link into your browser: https://maskin.io/verify?token=abc123

This link expires in 24 hours. If you didn't create a Maskin account, you can safely ignore this email.

----------------------------------------

Sent by Maskin — the shop where AI does the work and humans set direction.

You're getting this because you have a Maskin account. Manage email preferences https://maskin.io/settings/notifications."
`;
