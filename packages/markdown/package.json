{
	"name": "@maskin/markdown",
	"version": "0.0.1",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"exports": {
		"./plugins": {
			"types": "./src/plugins.ts",
			"default": "./dist/plugins.js"
		},
		"./render": {
			"types": "./src/render.ts",
			"default": "./dist/render.js"
		},
		"./sanitize": {
			"types": "./src/sanitize.ts",
			"default": "./dist/sanitize.js"
		},
		"./react": {
			"types": "./src/react/index.ts",
			"default": "./dist/react/index.js"
		},
		"./react/editor": {
			"types": "./src/react/editor.tsx",
			"default": "./dist/react/editor.js"
		},
		"./react/telemetry": {
			"types": "./src/react/telemetry.ts",
			"default": "./dist/react/telemetry.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"type-check": "tsc --noEmit",
		"test": "vitest"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"dependencies": {
		"@tiptap/extension-bubble-menu": "^2.10.0",
		"@tiptap/extension-code-block-lowlight": "^2.10.0",
		"@tiptap/extension-link": "^2.10.0",
		"@tiptap/extension-mention": "^2.10.0",
		"@tiptap/extension-placeholder": "^2.10.0",
		"@tiptap/extension-table": "^2.10.0",
		"@tiptap/extension-table-cell": "^2.10.0",
		"@tiptap/extension-table-header": "^2.10.0",
		"@tiptap/extension-table-row": "^2.10.0",
		"@tiptap/extension-task-item": "^2.10.0",
		"@tiptap/extension-task-list": "^2.10.0",
		"@tiptap/pm": "^2.10.0",
		"@tiptap/react": "^2.10.0",
		"@tiptap/starter-kit": "^2.10.0",
		"@tiptap/suggestion": "^2.10.0",
		"@types/hast": "^3.0.4",
		"hast-util-sanitize": "^5.0.2",
		"highlight.js": "^11.10.0",
		"lowlight": "^3.1.0",
		"react-markdown": "^9.0.1",
		"rehype-sanitize": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-breaks": "^4.0.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"tiptap-markdown": "^0.8.0",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.0.0"
	},
	"devDependencies": {
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"typescript": "^5.7.0",
		"vitest": "^3.0.0"
	}
}
