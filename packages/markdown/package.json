{
	"name": "@maskin/markdown",
	"version": "0.0.1",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"exports": {
		"./plugins": {
			"types": "./src/plugins.ts",
			"default": "./dist/plugins.js"
		},
		"./render": {
			"types": "./src/render.ts",
			"default": "./dist/render.js"
		},
		"./sanitize": {
			"types": "./src/sanitize.ts",
			"default": "./dist/sanitize.js"
		},
		"./serialize": {
			"types": "./src/serialize.ts",
			"default": "./dist/serialize.js"
		},
		"./tiptap": {
			"types": "./src/tiptap.ts",
			"default": "./dist/tiptap.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"type-check": "tsc --noEmit",
		"test": "vitest",
		"test:round-trip": "vitest run src/__tests__/round-trip.test.ts"
	},
	"dependencies": {
		"@types/hast": "^3.0.4",
		"hast-util-sanitize": "^5.0.2",
		"rehype-parse": "^9.0.0",
		"rehype-raw": "^7.0.0",
		"rehype-remark": "^10.0.0",
		"rehype-sanitize": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-breaks": "^4.0.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"remark-stringify": "^11.0.0",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.0.0"
	},
	"devDependencies": {
		"typescript": "^5.7.0",
		"vitest": "^3.0.0"
	}
}
