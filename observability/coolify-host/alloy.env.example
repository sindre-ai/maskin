# Grafana Alloy log + metrics shipping, COOLIFY HOST — deployment settings.
#
# Copy to /etc/default/alloy on the Coolify box (mode 0600 — it holds tokens).
#
# Everything here belongs to the ALLOY process. Unlike the agent-server host,
# NOTHING in this file is read by a Node process, so there are no values to
# keep in sync with an application .env and nothing to add to turbo.json
# globalPassThroughEnv.
#
# See ./README.md for the full setup, and ./alloy.alloy for how each value is
# consumed.

# --- Logs destination (required) --------------------------------------------

# Loki push endpoint. Use the SAME backend as your agent-server host — the whole
# point is that every box lands in one place and they are told apart by
# `instance`. Copy the value from that host's installed /etc/default/alloy rather
# than re-deriving it.
#   Grafana Cloud: https://logs-prod-<NNN>.grafana.net/loki/api/v1/push
#   Self-hosted:   http://loki.internal:3100/loki/api/v1/push
LOKI_URL=

# Grafana Cloud: username is the numeric LOKI stack/user id; password is an
# access policy token scoped to logs:write.
#
# You may reuse the agent-server host's token if its policy already covers
# logs:write + metrics:write. Consider a SEPARATE token per host anyway: it costs
# nothing, and it means revoking a compromised box does not blind the others.
#
# Self-hosted without auth: leave both blank AND comment out the basic_auth
# block in alloy.alloy — blank credentials still send an Authorization header.
LOKI_USERNAME=
LOKI_PASSWORD=

# Multi-tenant Loki only — sets X-Scope-OrgID. Leave blank for Grafana Cloud.
LOKI_TENANT_ID=

# --- Metrics destination (required) -----------------------------------------
#
# These are NOT the Loki values. Grafana Cloud runs logs and metrics on
# separate clusters with separate numeric usernames; reusing LOKI_USERNAME here
# produces a 401 that looks exactly like a bad token. Copy each value from the
# metrics page, not the logs page.

# Prometheus remote-write endpoint.
#   Grafana Cloud: https://prometheus-prod-<NN>-prod-<REGION>.grafana.net/api/prom/push
#   Self-hosted:   http://prometheus.internal:9090/api/v1/write
PROM_URL=

# Grafana Cloud: the numeric PROMETHEUS instance id. A DIFFERENT number from
# LOKI_USERNAME above — check them against each other before first push.
PROM_USERNAME=
PROM_PASSWORD=

# --- Labels (optional, defaults shown) --------------------------------------

# The `job` label on every shipped log line from this host. Deliberately NOT
# the agent-server host's value: these lines come from a different set of
# services on a different machine, and `job` is how you select one fleet from
# the other when both are in the same Loki.
LOKI_JOB_LABEL=maskin-coolify

# The `job` label on host metrics. Deliberately the SAME value the agent-server
# host uses, which is the opposite of the rule above — and on purpose. These
# series describe a Linux box (kernel, disks, NICs), and Grafana Cloud's
# prebuilt Linux Server dashboards filter on exactly this string. Matching it
# puts BOTH machines in the same prebuilt dashboard set, switchable by the
# `instance` dropdown, with no panel building. Change it and those dashboards
# render empty.
PROM_JOB_LABEL=integrations/node_exporter

# The `job` label on SeaweedFS's own metrics. Named after the service, so
# job="seaweedfs" selects it in PromQL and `up{job="seaweedfs"}` is a direct
# "is the storage layer answering" check.
SEAWEEDFS_PROM_JOB_LABEL=seaweedfs

# The `env` label. Applied to BOTH logs and metrics — keep it one value per
# deployment so the two line up, and keep it consistent with the agent-server
# host or a query filtered on env will silently cover only one machine.
DEPLOY_ENV=production

# The `instance` label, applied to logs AND both metrics pipelines. This is the
# join key: it is what makes {instance="..."} select this host in LogQL and in
# PromQL, which is the entire reason a CPU spike can be pivoted to this host's
# container logs for the same instant.
#
# Defaults to the machine's hostname. SET IT EXPLICITLY. Cloud images are
# routinely named after the image rather than the role — a hostname that says
# nothing about what the box does, is identical on every box built from it, and
# changes on a rebuild. A changed value here silently splits every dashboard and
# saved query at the moment it changes.
#
# Pick something you would recognise at 3am, and that pairs obviously with the
# name you gave the agent-server host.
COOLIFY_INSTANCE=

# --- Source (optional, defaults shown) --------------------------------------

# Docker API endpoint, used by BOTH discovery.docker and loki.source.docker.
# Only override for a remote or rootless daemon with a non-standard socket.
DOCKER_HOST_ADDR=unix:///var/run/docker.sock

# Where Alloy scrapes SeaweedFS. This is the HOST side of the port published by
# the seaweedfs service in docker-compose.prod.yml (127.0.0.1:9327:9327) — if
# you change it here, change it there too, and vice versa. A mismatch shows up
# as a permanently-down scrape target (up{job="seaweedfs"} == 0) while SeaweedFS
# itself is perfectly healthy.
SEAWEEDFS_METRICS_PORT=9327
